@{
    Layout = null;
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;
    var userName = Context.Session.GetString("UserName") ?? "";
    var userRole = Context.Session.GetString("UserRole") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>University NoteBank – Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --navy: #0b1929;
            --navy2: #112240;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --cream: #f7f3eb;
            --white: #ffffff;
            --muted: #8892a4;
            --card-bg: rgba(255,255,255,0.04);
            --border: rgba(201,168,76,0.2);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--navy);
            color: var(--white);
            overflow-x: hidden;
        }

        /* ── NAVBAR ── */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 0 60px;
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(11,25,41,0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(201,168,76,0.12);
            transition: background 0.3s;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .nav-logo {
            width: 40px;
            height: 40px;
            background: var(--gold);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .nav-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--white);
            letter-spacing: 0.3px;
        }

            .nav-title span {
                color: var(--gold);
            }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 36px;
            list-style: none;
        }

            .nav-links a {
                text-decoration: none;
                font-size: 0.88rem;
                font-weight: 400;
                color: var(--muted);
                letter-spacing: 0.5px;
                transition: color 0.2s;
                position: relative;
            }

                .nav-links a::after {
                    content: '';
                    position: absolute;
                    bottom: -4px;
                    left: 0;
                    width: 0;
                    height: 1.5px;
                    background: var(--gold);
                    transition: width 0.25s;
                }

                .nav-links a:hover {
                    color: var(--white);
                }

                    .nav-links a:hover::after {
                        width: 100%;
                    }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-ghost {
            padding: 9px 22px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--gold);
            font-family: 'Outfit', sans-serif;
            font-size: 0.88rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
            background: transparent;
            cursor: pointer;
        }

            .btn-ghost:hover {
                background: rgba(201,168,76,0.08);
                border-color: var(--gold);
            }

        .btn-solid {
            padding: 9px 22px;
            background: var(--gold);
            border: 1px solid var(--gold);
            border-radius: 8px;
            color: var(--navy);
            font-family: 'Outfit', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }

            .btn-solid:hover {
                background: var(--gold2);
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,168,76,0.3);
            }

        /* ── PROFILE DROPDOWN ── */
        .profile-menu {
            position: relative;
        }

        .profile-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(201,168,76,0.06);
            color: var(--white);
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
        }

            .profile-btn:hover {
                background: rgba(201,168,76,0.12);
            }

        .profile-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--navy);
            font-weight: 700;
        }

        .dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            background: var(--navy2);
            border: 1px solid var(--border);
            border-radius: 12px;
            min-width: 200px;
            overflow: hidden;
            display: none;
            z-index: 200;
            box-shadow: 0 16px 40px rgba(0,0,0,0.4);
        }

            .dropdown.open {
                display: block;
            }

        .dropdown-header {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .dropdown-name {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--white);
        }

        .dropdown-role {
            font-size: 0.72rem;
            color: var(--gold);
            margin-top: 2px;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            font-size: 0.85rem;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.15s;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            font-family: 'Outfit', sans-serif;
        }

            .dropdown-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--white);
            }

            .dropdown-item.danger {
                color: #f87171;
            }

                .dropdown-item.danger:hover {
                    background: rgba(239,68,68,0.08);
                }

        .dropdown-divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,0.06);
            margin: 4px 0;
        }

        /* ── HERO ── */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 120px 60px 80px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
                background-size: 60px 60px;
                mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
            }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }

        .orb1 {
            width: 500px;
            height: 500px;
            background: rgba(201,168,76,0.07);
            top: -100px;
            right: -100px;
        }

        .orb2 {
            width: 350px;
            height: 350px;
            background: rgba(17,34,64,0.8);
            bottom: 0;
            left: -80px;
        }

        .orb3 {
            width: 250px;
            height: 250px;
            background: rgba(201,168,76,0.05);
            bottom: 100px;
            right: 200px;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 760px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border: 1px solid var(--border);
            border-radius: 100px;
            font-size: 0.78rem;
            color: var(--gold);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 500;
            margin-bottom: 32px;
            background: rgba(201,168,76,0.06);
            animation: fadeUp 0.6s ease both;
        }

            .hero-badge::before {
                content: '';
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--gold);
                animation: pulse 2s ease infinite;
            }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.8);
            }
        }

        .hero h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 6vw, 5.5rem);
            font-weight: 700;
            line-height: 1.05;
            margin-bottom: 28px;
            animation: fadeUp 0.6s ease 0.1s both;
        }

            .hero h1 .line2 {
                color: var(--gold);
                display: block;
            }

            .hero h1 .line3 {
                color: rgba(255,255,255,0.35);
                display: block;
                font-weight: 400;
            }

        .hero-desc {
            font-size: 1.05rem;
            color: var(--muted);
            line-height: 1.8;
            max-width: 560px;
            margin-bottom: 44px;
            font-weight: 300;
            animation: fadeUp 0.6s ease 0.2s both;
        }

        .hero-cta {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            animation: fadeUp 0.6s ease 0.3s both;
        }

        .btn-hero-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 36px;
            background: var(--gold);
            color: var(--navy);
            border-radius: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s;
            border: none;
            cursor: pointer;
        }

            .btn-hero-primary:hover {
                background: var(--gold2);
                transform: translateY(-2px);
                box-shadow: 0 12px 36px rgba(201,168,76,0.35);
            }

        .btn-hero-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 32px;
            color: var(--white);
            border-radius: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            font-weight: 400;
            text-decoration: none;
            transition: all 0.25s;
            border: 1px solid rgba(255,255,255,0.12);
        }

            .btn-hero-secondary:hover {
                border-color: rgba(255,255,255,0.3);
                background: rgba(255,255,255,0.04);
            }

        .arrow {
            transition: transform 0.2s;
        }

        .btn-hero-primary:hover .arrow {
            transform: translateX(4px);
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── FEATURES ── */
        .features {
            padding: 100px 60px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 64px;
        }

        .section-tag {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 16px;
            display: block;
        }

        .section-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 700;
            color: var(--white);
            line-height: 1.2;
        }

            .section-title span {
                color: var(--gold);
            }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .feature-card {
            padding: 36px 30px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.02);
            transition: border-color 0.3s, transform 0.3s, background 0.3s;
            position: relative;
            overflow: hidden;
        }

            .feature-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: linear-gradient(90deg, transparent, var(--gold), transparent);
                opacity: 0;
                transition: opacity 0.3s;
            }

            .feature-card:hover {
                border-color: rgba(201,168,76,0.25);
                transform: translateY(-4px);
                background: rgba(255,255,255,0.04);
            }

                .feature-card:hover::before {
                    opacity: 1;
                }

        .feature-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(201,168,76,0.1);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
        }

        .feature-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 10px;
        }

        .feature-desc {
            font-size: 0.88rem;
            color: var(--muted);
            line-height: 1.7;
            font-weight: 300;
        }

        /* ── HOW IT WORKS ── */
        .how-it-works {
            padding: 80px 60px;
            background: rgba(255,255,255,0.02);
            border-top: 1px solid rgba(255,255,255,0.04);
        }

        .steps {
            display: flex;
            align-items: flex-start;
            gap: 0;
            max-width: 900px;
            margin: 0 auto;
            position: relative;
        }

            .steps::before {
                content: '';
                position: absolute;
                top: 32px;
                left: 10%;
                right: 10%;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--border), var(--border), transparent);
            }

        .step {
            flex: 1;
            text-align: center;
            padding: 0 24px;
        }

        .step-num {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--navy2);
            border: 2px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--gold);
            margin: 0 auto 20px;
            position: relative;
            z-index: 1;
        }

        .step-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 8px;
        }

        .step-desc {
            font-size: 0.82rem;
            color: var(--muted);
            line-height: 1.6;
        }

        /* ── CTA BANNER ── */
        .cta-banner {
            margin: 80px 60px;
            padding: 60px;
            border-radius: 24px;
            background: linear-gradient(135deg, var(--navy2) 0%, rgba(17,34,64,0.6) 100%);
            border: 1px solid var(--border);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .cta-banner::before {
                content: '';
                position: absolute;
                top: -2px;
                left: 20%;
                right: 20%;
                height: 2px;
                background: linear-gradient(90deg, transparent, var(--gold), transparent);
            }

            .cta-banner h2 {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2.5rem;
                font-weight: 700;
                color: var(--white);
                margin-bottom: 16px;
            }

                .cta-banner h2 span {
                    color: var(--gold);
                }

            .cta-banner p {
                color: var(--muted);
                font-size: 1rem;
                margin-bottom: 36px;
                font-weight: 300;
            }

        /* ── FOOTER ── */
        footer {
            padding: 32px 60px;
            border-top: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .footer-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            color: var(--white);
        }

            .footer-brand span {
                color: var(--gold);
            }

        .footer-copy {
            font-size: 0.8rem;
            color: var(--muted);
        }

        /* ── RECENT NOTES PANEL ── */
        .hero-visual {
            position: absolute;
            right: 60px;
            top: 50%;
            transform: translateY(-50%);
            width: 340px;
            animation: fadeUp 0.8s ease 0.4s both;
        }

        .recent-panel {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(201,168,76,0.18);
            border-radius: 20px;
            padding: 24px;
            backdrop-filter: blur(20px);
            position: relative;
        }

            .recent-panel::before {
                content: '';
                position: absolute;
                top: -1px;
                left: 30px;
                right: 30px;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--gold), transparent);
            }

        .recent-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .recent-panel-title {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--gold);
        }

        .recent-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--gold);
            animation: pulse 2s ease infinite;
        }

        .recent-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px;
            border-radius: 12px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            margin-bottom: 8px;
            transition: border-color 0.2s;
        }

            .recent-item:last-child {
                margin-bottom: 0;
            }

            .recent-item:hover {
                border-color: rgba(201,168,76,0.25);
            }

        .recent-item-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: rgba(201,168,76,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .recent-item-info {
            flex: 1;
            min-width: 0;
        }

        .recent-item-title {
            font-size: 0.84rem;
            font-weight: 500;
            color: var(--white);
            margin-bottom: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .recent-item-meta {
            font-size: 0.72rem;
            color: var(--muted);
        }

        .recent-item-badge {
            font-size: 0.68rem;
            padding: 3px 9px;
            border-radius: 100px;
            background: rgba(201,168,76,0.1);
            color: var(--gold);
            border: 1px solid var(--border);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .recent-empty {
            text-align: center;
            padding: 20px 0;
            color: var(--muted);
            font-size: 0.82rem;
        }

        @@media (max-width: 1100px) {
            .hero-visual {
                display: none;
            }
        }

        @@media (max-width: 768px) {
            nav {
                padding: 0 24px;
            }

            .nav-links {
                display: none;
            }

            .hero {
                padding: 100px 24px 60px;
            }

            .features {
                padding: 60px 24px;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .how-it-works {
                padding: 60px 24px;
            }

            .steps {
                flex-direction: column;
                align-items: center;
                gap: 32px;
            }

                .steps::before {
                    display: none;
                }

            .cta-banner {
                margin: 40px 24px;
                padding: 40px 24px;
            }

            footer {
                padding: 24px;
                flex-direction: column;
                gap: 12px;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- ══ NAVBAR ══ -->
    <nav>
        <a href="/" class="nav-brand">
            <div class="nav-logo">📚</div>
            <span class="nav-title">Note<span>Bank</span></span>
        </a>

        <ul class="nav-links">
            <li><a href="#features">Features</a></li>
            <li><a href="#how">How it Works</a></li>
            <li><a href="/Notes">Browse Notes</a></li>
            @if (isLoggedIn)
            {
                <li><a href="/NoteRequest/Create">Request a Note</a></li>
            }
        </ul>

        <div class="nav-actions">
            @if (isLoggedIn)
            {
                @if (userRole == "Admin")
                {
                    <a href="/Admin" class="btn-ghost">Admin Panel</a>
                }

                <div class="profile-menu">
                    <button class="profile-btn" onclick="toggleDropdown()">
                        <div class="profile-avatar">@userName.Substring(0, 1).ToUpper()</div>
                        @userName
                        <span style="font-size:0.7rem;opacity:0.6;">▾</span>
                    </button>
                    <div class="dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-name">@userName</div>
                            <div class="dropdown-role">@userRole</div>
                        </div>
                        <a href="/Notes" class="dropdown-item">📚 Browse Notes</a>
                        <a href="/Notes/MyUploads" class="dropdown-item">📋 My Uploads</a>
                        <a href="/Notes/Upload" class="dropdown-item">➕ Upload Note</a>
                        <a href="/NoteRequest/MyRequests" class="dropdown-item">📨 My Requests</a>
                        <a href="/NoteRequest/Create" class="dropdown-item">✉️ Request a Note</a>
                        <a href="/Account/Profile" class="dropdown-item">👤 Edit Profile</a>
                        <hr class="dropdown-divider" />
                        <a href="/Account/Logout" class="dropdown-item danger">🚪 Logout</a>
                    </div>
                </div>

                <a href="/Notes" class="btn-solid">Browse Notes</a>
            }
            else
            {
                <a href="/Account/Login" class="btn-ghost">Sign In</a>
                <a href="/Account/Register" class="btn-solid">Get Started</a>
            }
        </div>
    </nav>

    <!-- ══ HERO ══ -->
    <section class="hero">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>

        <div class="hero-content">
            <div class="hero-badge">✦ Academic Resource Platform</div>

            <h1>
                One Place for
                <span class="line2">All Your Study</span>
                <span class="line3">Notes &amp; Resources</span>
            </h1>

            <p class="hero-desc">
                University NoteBank brings every academic note together in one organized platform.
                Filter by level, term, and major — and access exactly what you need — instantly.
            </p>

            <div class="hero-cta">
                @if (isLoggedIn)
                {
                    <a href="/Notes" class="btn-hero-primary">
                        Browse Notes <span class="arrow">→</span>
                    </a>
                    <a href="/Notes/Upload" class="btn-hero-secondary">
                        ➕ Upload a Note
                    </a>
                    <a href="/NoteRequest/Create" class="btn-hero-secondary">
                        ✉️ Request a Note
                    </a>
                }
                else
                {
                    <a href="/Account/Register" class="btn-hero-primary">
                        Start Exploring <span class="arrow">→</span>
                    </a>
                    <a href="#features" class="btn-hero-secondary">
                        ▶ Learn More
                    </a>
                }
            </div>
        </div>

        <!-- Recent Notes Panel -->
        <div class="hero-visual">
            <div class="recent-panel">
                <div class="recent-panel-header">
                    <span class="recent-panel-title">✦ Recent Notes</span>
                    <div class="recent-dot"></div>
                </div>
                @{
                    var recentNotes = ViewBag.RecentNotes as List<University_Notebank.Models.Note>;
                }
                @if (recentNotes != null && recentNotes.Count > 0)
                {
                    @foreach (var note in recentNotes)
                    {
                        <div class="recent-item">
                            <div class="recent-item-icon">📄</div>
                            <div class="recent-item-info">
                                <div class="recent-item-title">@note.Title</div>
                                <div class="recent-item-meta">@note.Major?.Name · @note.Term?.Name</div>
                            </div>
                            @if (!string.IsNullOrEmpty(note.Level))
                            {
                                <span class="recent-item-badge">@note.Level</span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="recent-empty">No notes uploaded yet.</div>
                }
            </div>
        </div>
    </section>

    <!-- ══ FEATURES ══ -->
    <section class="features" id="features">
        <div class="section-header">
            <span class="section-tag">✦ Why NoteBank</span>
            <h2 class="section-title">Everything You Need to<br /><span>Study Smarter</span></h2>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">📂</div>
                <div class="feature-title">Organized by Major</div>
                <p class="feature-desc">Notes are neatly categorized by department and major so you always find what's relevant to your course.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔍</div>
                <div class="feature-title">Filter by Batch, Term &amp; Level</div>
                <p class="feature-desc">Instantly narrow down notes by term and academic level. No more endless scrolling through irrelevant content.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔐</div>
                <div class="feature-title">Secure Student Access</div>
                <p class="feature-desc">Role-based login ensures students and admins each have the right level of access — nothing more, nothing less.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <div class="feature-title">Fast &amp; Lightweight</div>
                <p class="feature-desc">Built for performance so you never wait to access your study materials on any connection.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🛠️</div>
                <div class="feature-title">Admin Content Control</div>
                <p class="feature-desc">Admins can add, edit, and delete notes with cover images — keeping the library accurate and up to date.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📱</div>
                <div class="feature-title">Works on Any Device</div>
                <p class="feature-desc">Fully responsive design means NoteBank works beautifully on your phone, tablet, or desktop.</p>
            </div>
        </div>
    </section>

    <!-- ══ HOW IT WORKS ══ -->
    <section class="how-it-works" id="how">
        <div class="section-header">
            <span class="section-tag">✦ Simple Process</span>
            <h2 class="section-title">Get Started in<br /><span>3 Easy Steps</span></h2>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">1</div>
                <div class="step-title">Create an Account</div>
                <p class="step-desc">Register and get instant access to the platform.</p>
            </div>
            <div class="step">
                <div class="step-num">2</div>
                <div class="step-title">Choose Your Major</div>
                <p class="step-desc">Select your department and filter by term and level to find the right notes.</p>
            </div>
            <div class="step">
                <div class="step-num">3</div>
                <div class="step-title">Access &amp; Study</div>
                <p class="step-desc">View note details, check cover images, and use them for your studies.</p>
            </div>
        </div>
    </section>

    <!-- ══ CTA BANNER ══ -->
    <section class="cta-banner">
        <h2>Ready to Study <span>Smarter?</span></h2>
        <p>Your academic notes, all in one place.</p>
        <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
            @if (isLoggedIn)
            {
                <a href="/Notes" class="btn-hero-primary">Browse Notes <span class="arrow">→</span></a>
                <a href="/Notes/Upload" class="btn-hero-secondary">Upload a Note</a>
                <a href="/NoteRequest/Create" class="btn-hero-secondary">✉️ Request a Note</a>
            }
            else
            {
                <a href="/Account/Register" class="btn-hero-primary">Create an Account <span class="arrow">→</span></a>
                <a href="/Notes" class="btn-hero-secondary">Browse Notes</a>
            }
        </div>
    </section>

    <!-- ══ FOOTER ══ -->
    <footer>
        <div class="footer-brand">University <span>NoteBank</span></div>
        <div class="footer-copy">© 2025 University NoteBank. Built for students, by students.</div>
    </footer>

    <script>
        function toggleDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const menu = document.querySelector('.profile-menu');
            if (menu && !menu.contains(e.target)) {
                document.getElementById('profileDropdown').classList.remove('open');
            }
        });
    </script>

</body>
</html>