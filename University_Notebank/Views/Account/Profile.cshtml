@model University_Notebank.Models.ProfileViewModel
@{
    Layout = null;
    var userName = Context.Session.GetString("UserName") ?? "";
    var userRole = Context.Session.GetString("UserRole") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Profile – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #f7f3eb;
            --navy: #0b1929;
            --navy2: #112240;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.1);
            --border: rgba(201,168,76,0.25);
            --border2: rgba(11,25,41,0.08);
            --white: #ffffff;
            --text: #1a2535;
            --muted: #6b7a8d;
            --red: #ef4444;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* NAVBAR */
        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 68px;
            padding: 0 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(247,243,235,0.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border2);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo {
            width: 38px;
            height: 38px;
            background: var(--navy);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nav-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--navy);
        }

            .nav-title span {
                color: var(--gold);
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-nav {
            padding: 8px 18px;
            border: 1.5px solid var(--border2);
            border-radius: 8px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.82rem;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-nav:hover {
                border-color: var(--navy);
                color: var(--navy);
            }

        /* PAGE HEADER */
        .page-header {
            background: var(--navy);
            padding: 40px 48px;
            position: relative;
            overflow: hidden;
        }

            .page-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .header-content {
            position: relative;
            z-index: 1;
            max-width: 700px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .avatar-large {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), var(--gold2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--navy);
            flex-shrink: 0;
            border: 3px solid rgba(255,255,255,0.1);
        }

        .header-text h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
        }

            .header-text h1 span {
                color: var(--gold);
            }

        .header-text p {
            color: rgba(255,255,255,0.45);
            font-size: 0.85rem;
            margin-top: 4px;
        }

        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 12px;
            border-radius: 100px;
            background: rgba(201,168,76,0.12);
            border: 1px solid var(--border);
            font-size: 0.72rem;
            color: var(--gold);
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-top: 6px;
        }

        /* MAIN */
        .main-area {
            max-width: 700px;
            margin: 0 auto;
            padding: 32px 48px;
        }

        /* SUCCESS */
        .success-msg {
            background: rgba(34,197,94,0.08);
            border: 1px solid rgba(34,197,94,0.2);
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 20px;
            font-size: 0.85rem;
            color: #15803d;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* PANELS */
        .form-panel {
            background: var(--white);
            border: 1px solid var(--border2);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .panel-head {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .panel-head-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--gold-dim);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .panel-head-text h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--navy);
        }

        .panel-head-text p {
            font-size: 0.75rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .panel-body {
            padding: 24px;
        }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group:last-child {
                margin-bottom: 0;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--muted);
            margin-bottom: 7px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        input[type="text"], input[type="email"], input[type="password"] {
            width: 100%;
            padding: 11px 14px;
            background: var(--bg);
            border: 1.5px solid var(--border2);
            border-radius: 9px;
            color: var(--text);
            font-family: 'Outfit', sans-serif;
            font-size: 0.9rem;
            font-weight: 300;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input::placeholder {
            color: var(--muted);
        }

        input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.1);
        }

        input[readonly] {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .error-box {
            background: rgba(239,68,68,0.06);
            border: 1px solid rgba(239,68,68,0.2);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: 0.83rem;
            color: #b91c1c;
        }

        /* Submit bar */
        .submit-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px;
            border-top: 1px solid var(--border2);
            background: rgba(11,25,41,0.01);
        }

        .submit-hint {
            font-size: 0.78rem;
            color: var(--muted);
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: 9px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-submit:hover {
                background: var(--navy2);
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(11,25,41,0.2);
            }

        @@media (max-width: 768px) {
            nav {
                padding: 0 20px;
            }

            .page-header {
                padding: 28px 20px;
            }

            .main-area {
                padding: 24px 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav>
        <a href="/" class="nav-brand">
            <div class="nav-logo">📚</div>
            <span class="nav-title">Note<span>Bank</span></span>
        </a>
        <div class="nav-right">
            <a href="/Notes" class="btn-nav">Browse Notes</a>
            <a href="/Notes/MyUploads" class="btn-nav">My Uploads</a>
            <a href="/Account/Logout" class="btn-nav">Logout</a>
        </div>
    </nav>

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="header-content">
            <div class="avatar-large">@userName.Substring(0, 1).ToUpper()</div>
            <div class="header-text">
                <h1>Edit <span>Profile</span></h1>
                <p>Update your personal information and password</p>
                <div class="role-pill">@userRole</div>
            </div>
        </div>
    </div>

    <!-- MAIN -->
    <div class="main-area">

        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="success-msg">✅ @TempData["ProfileSuccess"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>⚠ @error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/Account/Profile">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Role" value="@Model.Role" />

            <!-- Basic Info -->
            <div class="form-panel">
                <div class="panel-head">
                    <div class="panel-head-icon">👤</div>
                    <div class="panel-head-text">
                        <h3>Basic Information</h3>
                        <p>Update your name and email address</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="FullName" value="@Model.FullName" placeholder="Your full name" />
                        </div>
                        <div class="form-group">
                            <label>Role</label>
                            <input type="text" value="@Model.Role" readonly />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="Email" value="@Model.Email" placeholder="your@email.com" />
                    </div>
                </div>
            </div>

            <!-- Change Password -->
            <div class="form-panel">
                <div class="panel-head">
                    <div class="panel-head-icon">🔒</div>
                    <div class="panel-head-text">
                        <h3>Change Password</h3>
                        <p>Leave blank if you don't want to change your password</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="form-group">
                        <label>Current Password</label>
                        <input type="password" name="CurrentPassword" placeholder="Enter current password" />
                    </div>
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="NewPassword" placeholder="Minimum 6 characters" />
                    </div>
                </div>
                <div class="submit-bar">
                    <div class="submit-hint">Only fill password fields if you want to change it</div>
                    <button type="submit" class="btn-submit">Save Changes →</button>
                </div>
            </div>

        </form>
    </div>

</body>
</html>
