@model University_Notebank.Models.Note
@{
    Layout = null;
    var fileExt = Model.FileType?.TrimStart('.').ToUpper() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #f7f3eb;
            --navy: #0b1929;
            --navy2: #112240;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.1);
            --border: rgba(201,168,76,0.2);
            --border2: rgba(11,25,41,0.08);
            --white: #ffffff;
            --text: #1a2535;
            --muted: #6b7a8d;
            --card: #ffffff;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ── NAVBAR ── */
        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 68px;
            padding: 0 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(247,243,235,0.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border2);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo {
            width: 38px;
            height: 38px;
            background: var(--navy);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nav-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--navy);
        }

            .nav-title span {
                color: var(--gold);
            }

        .nav-back {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            border: 1.5px solid var(--border2);
            border-radius: 8px;
            font-size: 0.82rem;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.2s;
        }

            .nav-back:hover {
                border-color: var(--navy);
                color: var(--navy);
            }

        /* ── HERO STRIP ── */
        .hero-strip {
            background: var(--navy);
            padding: 48px 48px 0;
            position: relative;
            overflow: hidden;
        }

            .hero-strip::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .hero-inner {
            position: relative;
            z-index: 1;
            max-width: 1000px;
            margin: 0 auto;
            display: flex;
            gap: 40px;
            align-items: flex-end;
        }

        .hero-cover {
            width: 200px;
            height: 220px;
            border-radius: 16px 16px 0 0;
            overflow: hidden;
            flex-shrink: 0;
            border: 1px solid rgba(255,255,255,0.08);
            background: var(--navy2);
        }

            .hero-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .cover-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
        }

            .cover-placeholder::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(201,168,76,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.06) 1px, transparent 1px);
                background-size: 20px 20px;
            }

        .cover-placeholder-icon {
            font-size: 3.5rem;
            position: relative;
            z-index: 1;
        }

        .cover-placeholder-ext {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--gold);
            position: relative;
            z-index: 1;
            background: rgba(201,168,76,0.1);
            padding: 4px 12px;
            border-radius: 100px;
            border: 1px solid var(--border);
        }

        .hero-info {
            flex: 1;
            padding-bottom: 32px;
        }

        .hero-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .htag {
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 500;
        }

        .htag-gold {
            background: rgba(201,168,76,0.15);
            color: var(--gold);
            border: 1px solid rgba(201,168,76,0.3);
        }

        .htag-white {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.6);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(1.6rem, 3vw, 2.4rem);
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 12px;
        }

        .hero-uploader {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            color: rgba(255,255,255,0.4);
        }

        .uploader-av {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(201,168,76,0.15);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        /* ── MAIN LAYOUT ── */
        .main-layout {
            max-width: 1000px;
            margin: 0 auto;
            padding: 36px 48px;
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 28px;
        }

        /* ── PANELS ── */
        .panel {
            background: var(--card);
            border: 1px solid var(--border2);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

            .panel:last-child {
                margin-bottom: 0;
            }

        .panel-head {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ph-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--gold-dim);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .ph-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 600;
            color: var(--navy);
        }

        .panel-body {
            padding: 24px;
        }

        /* Description */
        .description-text {
            font-size: 0.92rem;
            color: var(--text);
            line-height: 1.8;
            font-weight: 300;
        }

        /* Meta grid */
        .meta-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .meta-item {
        }

        .meta-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--muted);
            letter-spacing: 1.2px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .meta-value {
            font-size: 0.9rem;
            color: var(--navy);
            font-weight: 500;
        }

        .meta-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.78rem;
            font-weight: 500;
        }

        .mb-navy {
            background: rgba(11,25,41,0.07);
            color: var(--navy);
            border: 1px solid rgba(11,25,41,0.1);
        }

        .mb-gold {
            background: rgba(201,168,76,0.1);
            color: #8a6a1a;
            border: 1px solid rgba(201,168,76,0.2);
        }

        .mb-blue {
            background: rgba(59,130,246,0.08);
            color: #2563eb;
            border: 1px solid rgba(59,130,246,0.15);
        }

        /* ── DOWNLOAD PANEL ── */
        .download-panel {
            background: var(--navy);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }

            .download-panel::before {
                content: '';
                position: absolute;
                top: -1px;
                left: 20%;
                right: 20%;
                height: 2px;
                background: linear-gradient(90deg, transparent, var(--gold), transparent);
            }

        .dl-file-info {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
            padding: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px;
        }

        .dl-file-icon {
            font-size: 2rem;
            flex-shrink: 0;
        }

        .dl-file-name {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.8);
            font-weight: 500;
            word-break: break-all;
            flex: 1;
        }

        .dl-file-size {
            font-size: 0.72rem;
            color: rgba(255,255,255,0.35);
            margin-top: 3px;
        }

        .dl-ext-badge {
            padding: 3px 10px;
            background: rgba(201,168,76,0.15);
            color: var(--gold);
            border: 1px solid var(--border);
            border-radius: 100px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 1px;
            flex-shrink: 0;
        }

        .btn-download {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 14px;
            background: var(--gold);
            color: var(--navy);
            border: none;
            border-radius: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }

            .btn-download:hover {
                background: var(--gold2);
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(201,168,76,0.3);
            }

        .dl-note {
            text-align: center;
            font-size: 0.72rem;
            color: rgba(255,255,255,0.25);
            margin-top: 10px;
        }

        /* No file state */
        .no-file {
            text-align: center;
            padding: 24px;
            color: var(--muted);
            font-size: 0.85rem;
        }

            .no-file span {
                font-size: 2rem;
                display: block;
                margin-bottom: 8px;
                opacity: 0.4;
            }

        /* ── SIDEBAR CARD ── */
        .info-card {
            background: var(--card);
            border: 1px solid var(--border2);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

            .info-card:last-child {
                margin-bottom: 0;
            }

        .ic-head {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border2);
            font-family: 'Cormorant Garamond', serif;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--navy);
        }

        .ic-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 20px;
            border-bottom: 1px solid rgba(11,25,41,0.04);
            font-size: 0.82rem;
        }

            .ic-row:last-child {
                border-bottom: none;
            }

        .ic-label {
            color: var(--muted);
        }

        .ic-val {
            color: var(--navy);
            font-weight: 500;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate {
            animation: fadeUp 0.5s ease both;
        }

        .d1 {
            animation-delay: 0.05s;
        }

        .d2 {
            animation-delay: 0.1s;
        }

        .d3 {
            animation-delay: 0.15s;
        }

        @@media (max-width: 768px) {
            nav {
                padding: 0 20px;
            }

            .hero-strip {
                padding: 32px 20px 0;
            }

            .hero-inner {
                flex-direction: column;
                gap: 20px;
            }

            .hero-cover {
                width: 140px;
                height: 160px;
            }

            .main-layout {
                grid-template-columns: 1fr;
                padding: 24px 20px;
            }
        }
    </style>
</head>
<body>

    <!-- ══ NAVBAR ══ -->
    <nav>
        <a href="/" class="nav-brand">
            <div class="nav-logo">📚</div>
            <span class="nav-title">Note<span>Bank</span></span>
        </a>
        <a href="/Notes" class="nav-back">← Back to Notes</a>
    </nav>

    <!-- ══ HERO STRIP ══ -->
    <div class="hero-strip">
        <div class="hero-inner">

            <!-- Cover -->
            <div class="hero-cover">
                @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                {
                    <img src="@Model.CoverImagePath" alt="@Model.Title" />
                }
                else
                {
                    <div class="cover-placeholder">
                        <span class="cover-placeholder-icon">
                            @if (Model.FileType == ".pdf")
                            {
                                <text>📕</text>
                            }
                            else if (Model.FileType == ".docx" || Model.FileType == ".doc")
                            {

                                <text>📘</text>
                            }
                            else if (Model.FileType == ".pptx" || Model.FileType == ".ppt")
                            {

                                <text>📙</text>
                            }
                            else
                            {

                                <text>📄</text>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(fileExt))
                        {
                            <span class="cover-placeholder-ext">@fileExt</span>
                        }
                    </div>
                }
            </div>

            <!-- Info -->
            <div class="hero-info">
                <div class="hero-tags">
                    @if (Model.Major != null)
                    {
                        <span class="htag htag-gold">@Model.Major.Name</span>
                    }
                    @if (Model.Term != null)
                    {
                        <span class="htag htag-white">@Model.Term.Name</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Level))
                    {
                        <span class="htag htag-white">@Model.Level</span>
                    }
                </div>

                <div class="hero-title">@Model.Title</div>

                <div class="hero-uploader">
                    <div class="uploader-av">👤</div>
                    Uploaded by @(Model.Uploader?.FullName ?? "Admin")
                    · @Model.CreatedAt.ToString("dd MMM yyyy")
                </div>
            </div>

        </div>
    </div>

    <!-- ══ MAIN LAYOUT ══ -->
    <div class="main-layout">

        <!-- LEFT COLUMN -->
        <div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="panel animate">
                    <div class="panel-head">
                        <div class="ph-icon">📋</div>
                        <div class="ph-title">Description</div>
                    </div>
                    <div class="panel-body">
                        <div class="description-text">@Model.Description</div>
                    </div>
                </div>
            }

            <!-- Meta Info -->
            <div class="panel animate d1">
                <div class="panel-head">
                    <div class="ph-icon">🏷️</div>
                    <div class="ph-title">Note Information</div>
                </div>
                <div class="panel-body">
                    <div class="meta-grid">
                        <div class="meta-item">
                            <div class="meta-label">Major</div>
                            <div class="meta-value">
                                <span class="meta-badge mb-navy">@(Model.Major?.Name ?? "—")</span>
                            </div>
                        </div>
                        <div class="meta-item">
                            <div class="meta-label">Term</div>
                            <div class="meta-value">
                                <span class="meta-badge mb-gold">@(Model.Term?.Name ?? "—")</span>
                            </div>
                        </div>
                        <div class="meta-item">
                            <div class="meta-label">Level</div>
                            <div class="meta-value">
                                <span class="meta-badge mb-blue">@(Model.Level ?? "—")</span>
                            </div>
                        </div>
                        <div class="meta-item">
                            <div class="meta-label">Upload Date</div>
                            <div class="meta-value">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="meta-item">
                            <div class="meta-label">Uploaded By</div>
                            <div class="meta-value">@(Model.Uploader?.FullName ?? "Admin")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(fileExt))
                        {
                            <div class="meta-item">
                                <div class="meta-label">File Type</div>
                                <div class="meta-value">@fileExt</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div>

            <!-- Download Panel -->
            <div class="download-panel animate d2">
                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="dl-file-info">
                        <span class="dl-file-icon">
                            @if (Model.FileType == ".pdf")
                            {
                                <text>📕</text>
                            }
                            else if (Model.FileType == ".docx" || Model.FileType == ".doc")
                            {

                                <text>📘</text>
                            }
                            else if (Model.FileType == ".pptx" || Model.FileType == ".ppt")
                            {

                                <text>📙</text>
                            }
                            else if (Model.FileType == ".mp4" || Model.FileType == ".avi")
                            {

                                <text>🎬</text>
                            }
                            else if (Model.FileType == ".zip" || Model.FileType == ".rar")
                            {

                                <text>🗜️</text>
                            }
                            else
                            {

                                <text>📄</text>
                            }
                        </span>
                        <div style="flex:1; min-width:0;">
                            <div class="dl-file-name">@(Model.FileName ?? "Note File")</div>
                            @if (Model.FileSize > 0)
                            {
                                <div class="dl-file-size">@((Model.FileSize / 1024.0 / 1024.0).ToString("0.00")) MB</div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(fileExt))
                        {
                            <span class="dl-ext-badge">@fileExt</span>
                        }
                    </div>

                    <a href="@Model.FilePath" download="@Model.FileName" class="btn-download">
                        ⬇ Download Note
                    </a>
                    <div class="dl-note">Click to download to your device</div>
                }
                else
                {
                    <div class="no-file">
                        <span>📭</span>
                        No file attached to this note yet.
                    </div>
                }
            </div>

            <!-- Quick Info Card -->
            <div class="info-card animate d3">
                <div class="ic-head">Quick Info</div>
                <div class="ic-row">
                    <span class="ic-label">Major</span>
                    <span class="ic-val">@(Model.Major?.Name ?? "—")</span>
                </div>
                <div class="ic-row">
                    <span class="ic-label">Term</span>
                    <span class="ic-val">@(Model.Term?.Name ?? "—")</span>
                </div>
                <div class="ic-row">
                    <span class="ic-label">Level</span>
                    <span class="ic-val">@(Model.Level ?? "—")</span>
                </div>
                <div class="ic-row">
                    <span class="ic-label">Uploaded by</span>
                    <span class="ic-val">@(Model.Uploader?.FullName ?? "Admin")</span>
                </div>
                <div class="ic-row">
                    <span class="ic-label">Date</span>
                    <span class="ic-val">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
