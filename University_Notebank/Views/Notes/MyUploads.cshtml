@model List<University_Notebank.Models.Note>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Uploads – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #f7f3eb;
            --navy: #0b1929;
            --navy2: #112240;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.1);
            --border: rgba(201,168,76,0.25);
            --border2: rgba(11,25,41,0.08);
            --white: #ffffff;
            --text: #1a2535;
            --muted: #6b7a8d;
            --success: #22c55e;
            --red: #ef4444;
            --purple: #a855f7;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        nav {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 68px;
            padding: 0 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(247,243,235,0.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border2);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo {
            width: 38px;
            height: 38px;
            background: var(--navy);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nav-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--navy);
        }

            .nav-title span {
                color: var(--gold);
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .nav-user {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: var(--muted);
        }

        .nav-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--gold-dim);
            border: 1.5px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .btn-nav {
            padding: 8px 18px;
            border: 1.5px solid var(--border2);
            border-radius: 8px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.82rem;
            color: var(--muted);
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-nav:hover {
                border-color: var(--navy);
                color: var(--navy);
            }

        .btn-nav-gold {
            background: var(--navy);
            color: #fff !important;
            border-color: var(--navy) !important;
        }

            .btn-nav-gold:hover {
                background: var(--navy2) !important;
            }

        .page-header {
            background: var(--navy);
            padding: 40px 48px;
            position: relative;
            overflow: hidden;
        }

            .page-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
                background-size: 48px 48px;
            }

        .header-content {
            position: relative;
            z-index: 1;
            max-width: 1000px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
        }

            .header-left h1 span {
                color: var(--gold);
            }

        .header-left p {
            color: rgba(255,255,255,0.45);
            font-size: 0.85rem;
            margin-top: 4px;
        }

        .btn-upload {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 22px;
            background: var(--gold);
            color: var(--navy);
            border-radius: 9px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-upload:hover {
                background: var(--gold2);
                transform: translateY(-1px);
            }

        /* Success message */
        .success-msg {
            background: rgba(34,197,94,0.08);
            border: 1px solid rgba(34,197,94,0.2);
            border-radius: 10px;
            padding: 14px 18px;
            margin-bottom: 20px;
            font-size: 0.85rem;
            color: #15803d;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .main-content {
            max-width: 1000px;
            margin: 0 auto;
            padding: 36px 48px;
        }

        /* Status badges */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: rgba(201,168,76,0.12);
            color: #92651a;
            border: 1px solid rgba(201,168,76,0.25);
        }

        .status-approved {
            background: rgba(34,197,94,0.1);
            color: #15803d;
            border: 1px solid rgba(34,197,94,0.2);
        }

        .status-rejected {
            background: rgba(239,68,68,0.1);
            color: #b91c1c;
            border: 1px solid rgba(239,68,68,0.2);
        }

        /* Table */
        .table-panel {
            background: var(--white);
            border: 1px solid var(--border2);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .table-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--navy);
        }

        .table-sub {
            font-size: 0.75rem;
            color: var(--muted);
            margin-top: 2px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 12px 20px;
            text-align: left;
            font-size: 0.7rem;
            color: var(--muted);
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border-bottom: 1px solid var(--border2);
            background: rgba(11,25,41,0.01);
        }

        tbody tr {
            border-bottom: 1px solid rgba(11,25,41,0.04);
            transition: background 0.15s;
        }

            tbody tr:last-child {
                border-bottom: none;
            }

            tbody tr:hover {
                background: rgba(201,168,76,0.03);
            }

        td {
            padding: 14px 20px;
            font-size: 0.85rem;
            vertical-align: middle;
        }

        .td-title {
            color: var(--navy);
            font-weight: 500;
            max-width: 220px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .td-muted {
            color: var(--muted);
            font-size: 0.8rem;
        }

        .tag {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        .tag-major {
            background: rgba(11,25,41,0.07);
            color: var(--navy);
            border: 1px solid rgba(11,25,41,0.1);
        }

        .tag-term {
            background: rgba(201,168,76,0.1);
            color: #8a6a1a;
            border: 1px solid rgba(201,168,76,0.2);
        }

        .empty-state {
            text-align: center;
            padding: 60px 24px;
        }

        .empty-icon {
            font-size: 3.5rem;
            display: block;
            margin-bottom: 16px;
            opacity: 0.35;
        }

        .empty-state h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            color: var(--navy);
            margin-bottom: 8px;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 0.85rem;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            nav {
                padding: 0 20px;
            }

            .page-header {
                padding: 28px 20px;
            }

            .main-content {
                padding: 24px 20px;
            }
        }
    </style>
</head>
<body>

    <nav>
        <a href="/Notes" class="nav-brand">
            <div class="nav-logo">📚</div>
            <span class="nav-title">Note<span>Bank</span></span>
        </a>
        <div class="nav-right">
            <div class="nav-user">
                <div class="nav-avatar">👤</div>
                <span>@Context.Session.GetString("UserName")</span>
            </div>
            <a href="/Notes" class="btn-nav">Browse Notes</a>
            <a href="/Notes/Upload" class="btn-nav btn-nav-gold">+ Upload Note</a>
            <a href="/Account/Logout" class="btn-nav">Logout</a>
        </div>
    </nav>

    <div class="page-header">
        <div class="header-content">
            <div class="header-left">
                <h1>My <span>Uploads</span></h1>
                <p>Track the status of your submitted notes</p>
            </div>
            <a href="/Notes/Upload" class="btn-upload">➕ Upload New Note</a>
        </div>
    </div>

    <div class="main-content">

        @if (TempData["UploadSuccess"] != null)
        {
            <div class="success-msg">
                ✅ @TempData["UploadSuccess"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="table-panel">
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <h3>No Uploads Yet</h3>
                    <p>You haven't uploaded any notes yet. Share your knowledge!</p>
                    <a href="/Notes/Upload" class="btn-upload">Upload Your First Note</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-panel">
                <div class="table-header">
                    <div>
                        <div class="table-title">Your Submitted Notes</div>
                        <div class="table-sub">@Model.Count note@(Model.Count != 1 ? "s" : "") submitted</div>
                    </div>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Major</th>
                            <th>Term</th>
                            <th>Submitted</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model)
                        {
                            <tr>
                                <td class="td-title" title="@note.Title">@note.Title</td>
                                <td><span class="tag tag-major">@note.Major?.Name</span></td>
                                <td><span class="tag tag-term">@note.Term?.Name</span></td>
                                <td class="td-muted">@note.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (note.Status == "Approved")
                                    {
                                        <span class="status-badge status-approved">✓ Approved</span>
                                    }
                                    else if (note.Status == "Rejected")
                                    {
                                        <span class="status-badge status-rejected">✕ Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">⏳ Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</body>
</html>
