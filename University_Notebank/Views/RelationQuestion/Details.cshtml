@model University_Notebank.Models.RelationQuestion
@{
    Layout = null;
    int? currentUserId = Context.Session.GetInt32("UserId");
    string role = Context.Session.GetString("UserRole") ?? "";
    bool isTeacher = role == "Teacher" || role == "Admin";
    bool isOwner = isTeacher && currentUserId.HasValue && Model.UserId == currentUserId.Value;
    bool alreadyAnswered = (bool)(ViewBag.AlreadyAnswered ?? false);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:#080f1a; --panel:#0f1d30; --panel2:#122038;
            --gold:#c9a84c; --gold2:#e8c96a; --gold-dim:rgba(201,168,76,0.1);
            --border:rgba(201,168,76,0.18); --border2:rgba(255,255,255,0.05);
            --white:#ffffff; --muted:#6b7a99; --muted2:#8892a4;
            --input-bg:#0b1828; --sidebar:#0b1525;
        }
        body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--white); display:flex; min-height:100vh; }
        .sidebar { width:260px; background:var(--sidebar); border-right:1px solid var(--border2); display:flex; flex-direction:column; position:fixed; top:0; left:0; bottom:0; z-index:50; }
        .sidebar-brand { padding:28px 24px 24px; border-bottom:1px solid var(--border2); display:flex; align-items:center; gap:12px; }
        .brand-logo { width:40px; height:40px; background:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; }
        .brand-name { font-family:'Cormorant Garamond',serif; font-size:1.15rem; font-weight:700; }
        .brand-sub { font-size:0.7rem; color:var(--gold); letter-spacing:1.5px; text-transform:uppercase; }
        .sidebar-nav { flex:1; padding:24px 16px; display:flex; flex-direction:column; gap:4px; }
        .nav-label { font-size:0.65rem; color:var(--muted); letter-spacing:2px; text-transform:uppercase; padding:12px 8px 6px; font-weight:600; }
        .nav-item { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:10px; text-decoration:none; color:var(--muted2); font-size:0.88rem; transition:all 0.2s; position:relative; }
        .nav-item:hover { background:rgba(255,255,255,0.04); color:var(--white); }
        .nav-item.active { background:var(--gold-dim); color:var(--gold); border:1px solid var(--border); }
        .nav-item.active::before { content:''; position:absolute; left:0; top:20%; bottom:20%; width:3px; background:var(--gold); border-radius:0 4px 4px 0; }
        .sidebar-footer { padding:16px; border-top:1px solid var(--border2); }
        .user-profile { display:flex; align-items:center; gap:10px; padding:12px; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid var(--border2); }
        .user-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--gold2)); display:flex; align-items:center; justify-content:center; font-size:16px; }
        .user-name { font-size:0.82rem; font-weight:600; }
        .user-role { font-size:0.7rem; color:var(--gold); }
        .main { margin-left:260px; flex:1; display:flex; flex-direction:column; }
        .topbar { height:68px; padding:0 36px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border2); background:rgba(8,15,26,0.8); backdrop-filter:blur(12px); position:sticky; top:0; z-index:40; }
        .breadcrumb { display:flex; align-items:center; gap:8px; font-size:0.82rem; margin-bottom:3px; }
        .breadcrumb a { color:var(--muted); text-decoration:none; }
        .breadcrumb a:hover { color:var(--gold); }
        .breadcrumb .current { color:var(--white); font-weight:500; }
        .topbar-title { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:700; }
        .btn-back { padding:9px 20px; border:1px solid var(--border2); border-radius:9px; color:var(--muted2); font-size:0.85rem; text-decoration:none; transition:all 0.2s; }
        .btn-back:hover { border-color:var(--border); color:var(--white); }
        .content { padding:36px; flex:1; max-width:820px; display:flex; flex-direction:column; gap:24px; }

        /* QUESTION CARD */
        .q-card { background:var(--panel); border:1px solid var(--border2); border-radius:18px; overflow:hidden; }
        .q-card-head { padding:22px 28px; border-bottom:1px solid var(--border2); }
        .q-meta { display:flex; align-items:center; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
        .badge { display:inline-flex; align-items:center; gap:4px; padding:5px 14px; border-radius:100px; font-size:0.72rem; font-weight:600; }
        .badge-open { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.2); }
        .badge-active { background:rgba(59,130,246,0.1); color:#60a5fa; border:1px solid rgba(59,130,246,0.2); }
        .badge-closed { background:rgba(107,114,153,0.15); color:var(--muted2); border:1px solid rgba(107,114,153,0.2); }
        .badge-draft { background:rgba(201,168,76,0.1); color:var(--gold); border:1px solid var(--border); }
        .tag { display:inline-flex; padding:3px 10px; background:rgba(255,255,255,0.04); border:1px solid var(--border2); border-radius:100px; font-size:0.7rem; color:var(--muted2); }
        .q-title-text { font-family:'Cormorant Garamond',serif; font-size:1.4rem; font-weight:700; line-height:1.4; }
        .q-body-text { padding:22px 28px; font-size:0.9rem; line-height:1.75; color:rgba(255,255,255,0.85); white-space:pre-wrap; }
        .q-footer { padding:14px 28px; border-top:1px solid var(--border2); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
        .q-teacher-info { font-size:0.75rem; color:var(--muted); }
        .q-teacher-info span { color:var(--gold2); font-weight:500; }
        .q-deadline-info { font-size:0.75rem; }
        .deadline-ok { color:#4ade80; }
        .deadline-soon { color:#facc15; }
        .deadline-passed { color:#f87171; }

        /* ANSWER FORM */
        .answer-form-card { background:var(--panel); border:1px solid var(--border2); border-radius:16px; overflow:hidden; }
        .form-head { padding:18px 24px; border-bottom:1px solid var(--border2); display:flex; align-items:center; gap:12px; }
        .form-icon { width:36px; height:36px; border-radius:9px; background:var(--gold-dim); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:17px; }
        .form-title { font-family:'Cormorant Garamond',serif; font-size:1rem; font-weight:600; }
        .form-sub { font-size:0.7rem; color:var(--muted); margin-top:1px; }
        .form-body { padding:20px 24px; }
        .form-body textarea { width:100%; padding:14px 16px; background:var(--input-bg); border:1.5px solid rgba(255,255,255,0.07); border-radius:10px; color:var(--white); font-family:'Outfit',sans-serif; font-size:0.9rem; outline:none; resize:vertical; min-height:130px; line-height:1.65; transition:border-color 0.2s; }
        .form-body textarea:focus { border-color:var(--gold); box-shadow:0 0 0 3px rgba(201,168,76,0.1); }
        .form-body textarea::placeholder { color:var(--muted); }
        .form-footer { padding:14px 24px; border-top:1px solid var(--border2); display:flex; justify-content:flex-end; }
        .btn-submit { display:inline-flex; align-items:center; gap:8px; padding:11px 28px; background:var(--gold); color:var(--bg); border:none; border-radius:9px; font-family:'Outfit',sans-serif; font-size:0.88rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
        .btn-submit:hover { background:var(--gold2); }

        /* ALERTS */
        .alert { padding:14px 20px; border-radius:10px; font-size:0.88rem; }
        .alert-success { background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.3); color:#4ade80; }
        .alert-info { background:rgba(59,130,246,0.08); border:1px solid rgba(59,130,246,0.2); color:#93c5fd; }
        .alert-warning { background:rgba(234,179,8,0.08); border:1px solid rgba(234,179,8,0.25); color:#fde047; }
        .notice-box { padding:16px 22px; text-align:center; font-size:0.82rem; background:var(--panel); border:1px solid var(--border2); border-radius:12px; color:var(--muted); }
        .notice-box a { color:var(--gold); }

        /* TEACHER VIEW ANSWERS LINK */
        .view-answers-btn { display:inline-flex; align-items:center; gap:8px; padding:11px 24px; background:rgba(59,130,246,0.1); border:1px solid rgba(59,130,246,0.2); border-radius:10px; color:#60a5fa; font-family:'Outfit',sans-serif; font-size:0.88rem; font-weight:600; text-decoration:none; transition:all 0.2s; }
        .view-answers-btn:hover { background:rgba(59,130,246,0.18); }

        @@media(max-width:768px) { .sidebar{display:none} .main{margin-left:0} .content{padding:20px} .topbar{padding:0 20px} }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div><div class="brand-name">NoteBank</div><div class="brand-sub">@(isTeacher ? "Teacher Panel" : "Student Portal")</div></div>
        </div>
        <nav class="sidebar-nav">
            @if (isTeacher)
            {
                <div class="nav-label">Questions</div>
                <a href="/RelationQuestion/TeacherPanel" class="nav-item active"><span>📋</span> My Questions</a>
                <a href="/RelationQuestion/Create" class="nav-item"><span>✏️</span> Ask New Question</a>
                <div class="nav-label">Notes</div>
                <a href="/Notes" class="nav-item"><span>🏠</span> Browse Notes</a>
            }
            else
            {
                <div class="nav-label">Browse</div>
                <a href="/Notes" class="nav-item"><span>🏠</span> Notes</a>
                <a href="/RelationQuestion" class="nav-item active"><span>❓</span> Teacher Questions</a>
                <div class="nav-label">My Account</div>
                <a href="/Notes/MyUploads" class="nav-item"><span>📋</span> My Uploads</a>
                <a href="/NoteRequest/MyRequests" class="nav-item"><span>📨</span> My Requests</a>
            }
            <div class="nav-label">Account</div>
            <a href="/Account/Profile" class="nav-item"><span>👤</span> Profile</a>
            <a href="/Account/Logout" class="nav-item"><span>🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">@(isTeacher ? "🎓" : "👤")</div>
                <div>
                    <div class="user-name">@Context.Session.GetString("UserName")</div>
                    <div class="user-role">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div>
                <div class="breadcrumb">
                    @if (isTeacher)
                    {
                        <a href="/RelationQuestion/TeacherPanel">My Questions</a><span>›</span>
                    }
                    else
                    {
                        <a href="/RelationQuestion">Questions</a><span>›</span>
                    }
                    <span class="current">Details</span>
                </div>
                <div class="topbar-title">Question Details</div>
            </div>
            <a href="@(isTeacher ? "/RelationQuestion/TeacherPanel" : "/RelationQuestion")" class="btn-back">← Back</a>
        </div>

        <div class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning">⚠️ @TempData["Error"]</div>
            }

            <!-- QUESTION -->
            <div class="q-card">
                <div class="q-card-head">
                    <div class="q-meta">
                        @{
                            var badgeClass = Model.Status switch { "Active" => "badge-active", "Closed" => "badge-closed", _ => "badge-open" };
                            var statusIcon = Model.Status switch { "Active" => "✍️", "Closed" => "🔒", _ => "🟢" };
                        }
                        <span class="badge @badgeClass">@statusIcon @Model.Status</span>
                        @if (!Model.IsPublished) { <span class="badge badge-draft">📝 Draft</span> }
                        @if (Model.Major != null) { <span class="tag">@Model.Major.Name</span> }
                        @if (Model.Term != null) { <span class="tag">@Model.Term.Name</span> }
                        @if (Model.Note != null) { <span class="tag">📄 @Model.Note.Title</span> }
                    </div>
                    <div class="q-title-text">@Model.Title</div>
                </div>
                <div class="q-body-text">@Model.Body</div>
                <div class="q-footer">
                    <div class="q-teacher-info">
                        Asked by Teacher: <span>@Model.User?.FullName</span> · @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                    @if (Model.Deadline.HasValue)
                    {
                        var diff = (Model.Deadline.Value - DateTime.Now).TotalDays;
                        var dClass = diff < 0 ? "deadline-passed" : (diff < 2 ? "deadline-soon" : "deadline-ok");
                        var dText = diff < 0 ? $"⏰ Deadline passed ({Model.Deadline.Value:dd MMM})" : (diff < 1 ? "⏰ Due today!" : $"⏰ Due {Model.Deadline.Value:dd MMM yyyy}");
                        <span class="q-deadline-info @dClass">@dText</span>
                    }
                </div>
            </div>

            <!-- TEACHER: show link to view all answers -->
            @if (isOwner)
            {
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                    <span style="font-size:0.85rem;color:var(--muted);">
                        Students submitted <strong style="color:var(--white);">@Model.Answers.Count</strong> answer(s) so far.
                    </span>
                    <a href="/RelationQuestion/ViewAnswers/@Model.Id" class="view-answers-btn">📋 View All Student Answers</a>
                </div>
            }

            <!-- STUDENT: answer form -->
            @if (!isTeacher)
            {
                if (Model.Status == "Closed")
                {
                    <div class="notice-box">🔒 Teacher এই প্রশ্নটি বন্ধ করে দিয়েছেন — আর উত্তর দেওয়া যাবে না।</div>
                }
                else if (alreadyAnswered)
                {
                    <div class="alert alert-info">✅ আপনি ইতিমধ্যে এই প্রশ্নের উত্তর দিয়েছেন। Teacher শীঘ্রই review করবেন।</div>
                }
                else if (!currentUserId.HasValue)
                {
                    <div class="notice-box"><a href="/Account/Login">Login</a> করুন উত্তর দিতে।</div>
                }
                else
                {
                    <div class="answer-form-card">
                        <div class="form-head">
                            <div class="form-icon">✍️</div>
                            <div>
                                <div class="form-title">Submit Your Answer</div>
                                <div class="form-sub">আপনার উত্তরটি সাবধানে লিখুন — teacher দেখবেন এবং marks দিতে পারবেন</div>
                            </div>
                        </div>
                        <form method="post" action="/RelationQuestion/PostAnswer">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="questionId" value="@Model.Id" />
                            <div class="form-body">
                                <textarea name="body" placeholder="আপনার উত্তরটি এখানে লিখুন..." required></textarea>
                            </div>
                            <div class="form-footer">
                                <button type="submit" class="btn-submit">Submit Answer →</button>
                            </div>
                        </form>
                    </div>
                }
            }
        </div>
    </div>
</body>
</html>
