@model University_Notebank.Models.RelationQuestion
@{
    Layout = null;
    int? currentUserId = Context.Session.GetInt32("UserId");
    bool isOwner = currentUserId.HasValue && Model.UserId == currentUserId.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Question Details – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:#080f1a; --panel:#0f1d30; --panel2:#122038;
            --gold:#c9a84c; --gold2:#e8c96a; --gold-dim:rgba(201,168,76,0.1);
            --border:rgba(201,168,76,0.18); --border2:rgba(255,255,255,0.05);
            --white:#ffffff; --muted:#6b7a99; --muted2:#8892a4;
            --input-bg:#0b1828; --sidebar:#0b1525;
            --green:rgba(34,197,94,0.12); --green-border:rgba(34,197,94,0.25); --green-text:#4ade80;
        }
        body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--white); display:flex; min-height:100vh; }

        /* SIDEBAR */
        .sidebar { width:260px; background:var(--sidebar); border-right:1px solid var(--border2); display:flex; flex-direction:column; position:fixed; top:0; left:0; bottom:0; z-index:50; }
        .sidebar-brand { padding:28px 24px 24px; border-bottom:1px solid var(--border2); display:flex; align-items:center; gap:12px; }
        .brand-logo { width:40px; height:40px; background:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; }
        .brand-name { font-family:'Cormorant Garamond',serif; font-size:1.15rem; font-weight:700; }
        .brand-sub { font-size:0.7rem; color:var(--gold); letter-spacing:1.5px; text-transform:uppercase; }
        .sidebar-nav { flex:1; padding:24px 16px; display:flex; flex-direction:column; gap:4px; }
        .nav-label { font-size:0.65rem; color:var(--muted); letter-spacing:2px; text-transform:uppercase; padding:12px 8px 6px; font-weight:600; }
        .nav-item { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:10px; text-decoration:none; color:var(--muted2); font-size:0.88rem; transition:all 0.2s; position:relative; }
        .nav-item:hover { background:rgba(255,255,255,0.04); color:var(--white); }
        .nav-item.active { background:var(--gold-dim); color:var(--gold); border:1px solid var(--border); }
        .nav-item.active::before { content:''; position:absolute; left:0; top:20%; bottom:20%; width:3px; background:var(--gold); border-radius:0 4px 4px 0; }
        .sidebar-footer { padding:16px; border-top:1px solid var(--border2); }
        .user-profile { display:flex; align-items:center; gap:10px; padding:12px; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid var(--border2); }
        .user-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--gold2)); display:flex; align-items:center; justify-content:center; font-size:16px; }
        .user-name { font-size:0.82rem; font-weight:600; }
        .user-role { font-size:0.7rem; color:var(--gold); }

        /* MAIN */
        .main { margin-left:260px; flex:1; display:flex; flex-direction:column; }
        .topbar { height:68px; padding:0 36px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border2); background:rgba(8,15,26,0.8); backdrop-filter:blur(12px); position:sticky; top:0; z-index:40; }
        .breadcrumb { display:flex; align-items:center; gap:8px; font-size:0.82rem; margin-bottom:3px; }
        .breadcrumb a { color:var(--muted); text-decoration:none; }
        .breadcrumb a:hover { color:var(--gold); }
        .breadcrumb .current { color:var(--white); font-weight:500; }
        .topbar-title { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:700; }
        .btn-back { padding:9px 20px; border:1px solid var(--border2); border-radius:9px; color:var(--muted2); font-size:0.85rem; text-decoration:none; transition:all 0.2s; }
        .btn-back:hover { border-color:var(--border); color:var(--white); }
        .content { padding:36px; flex:1; max-width:860px; display:flex; flex-direction:column; gap:24px; }

        /* QUESTION CARD */
        .question-card { background:var(--panel); border:1px solid var(--border2); border-radius:18px; overflow:hidden; }
        .question-head { padding:22px 28px; border-bottom:1px solid var(--border2); }
        .question-meta { display:flex; align-items:center; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
        .badge { display:inline-flex; align-items:center; gap:5px; padding:5px 14px; border-radius:100px; font-size:0.72rem; font-weight:600; }
        .badge-open { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.2); }
        .badge-answered { background:rgba(59,130,246,0.1); color:#60a5fa; border:1px solid rgba(59,130,246,0.2); }
        .badge-closed { background:rgba(107,114,153,0.15); color:var(--muted2); border:1px solid rgba(107,114,153,0.2); }
        .tag { display:inline-flex; padding:3px 10px; background:rgba(255,255,255,0.04); border:1px solid var(--border2); border-radius:100px; font-size:0.7rem; color:var(--muted2); }
        .question-title-text { font-family:'Cormorant Garamond',serif; font-size:1.35rem; font-weight:700; line-height:1.4; }
        .question-body-text { padding:22px 28px; font-size:0.9rem; line-height:1.7; color:rgba(255,255,255,0.85); white-space:pre-wrap; }
        .question-footer { padding:14px 28px; border-top:1px solid var(--border2); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
        .q-author { font-size:0.75rem; color:var(--muted); }
        .q-author span { color:var(--muted2); }
        .btn-close { padding:7px 16px; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.2); border-radius:8px; color:#f87171; font-family:'Outfit',sans-serif; font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
        .btn-close:hover { background:rgba(239,68,68,0.15); }

        /* ANSWERS */
        .section-title { font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-weight:600; margin-bottom:14px; display:flex; align-items:center; gap:10px; }
        .section-title .count { font-family:'Outfit',sans-serif; font-size:0.8rem; font-weight:500; color:var(--muted); background:rgba(255,255,255,0.05); padding:2px 10px; border-radius:100px; }
        .answer-list { display:flex; flex-direction:column; gap:14px; }
        .answer-card { background:var(--panel); border:1px solid var(--border2); border-radius:14px; overflow:hidden; transition:border-color 0.2s; }
        .answer-card.accepted { border-color:rgba(34,197,94,0.35); background:rgba(34,197,94,0.04); }
        .answer-card-head { padding:14px 22px; border-bottom:1px solid var(--border2); display:flex; align-items:center; justify-content:space-between; gap:10px; }
        .answer-card.accepted .answer-card-head { border-bottom-color:rgba(34,197,94,0.15); }
        .answer-author { font-size:0.78rem; color:var(--muted); }
        .answer-author span { color:var(--muted2); font-weight:500; }
        .accepted-badge { display:inline-flex; align-items:center; gap:5px; font-size:0.72rem; font-weight:600; color:var(--green-text); background:var(--green); border:1px solid var(--green-border); padding:3px 12px; border-radius:100px; }
        .answer-body { padding:18px 22px; font-size:0.88rem; line-height:1.7; color:rgba(255,255,255,0.85); white-space:pre-wrap; }
        .answer-actions { padding:10px 22px; border-top:1px solid var(--border2); display:flex; justify-content:flex-end; }
        .btn-accept { padding:6px 16px; background:var(--green); border:1px solid var(--green-border); border-radius:8px; color:var(--green-text); font-family:'Outfit',sans-serif; font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
        .btn-accept:hover { background:rgba(34,197,94,0.2); }
        .no-answers { text-align:center; padding:50px 20px; background:var(--panel); border:1px solid var(--border2); border-radius:14px; }
        .no-answers-icon { font-size:2.2rem; opacity:0.3; display:block; margin-bottom:10px; }
        .no-answers-text { font-size:0.82rem; color:var(--muted); }

        /* ANSWER FORM */
        .answer-form-card { background:var(--panel); border:1px solid var(--border2); border-radius:16px; overflow:hidden; }
        .form-head { padding:18px 24px; border-bottom:1px solid var(--border2); display:flex; align-items:center; gap:12px; }
        .form-head-icon { width:36px; height:36px; border-radius:9px; background:var(--gold-dim); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:17px; }
        .form-head-title { font-family:'Cormorant Garamond',serif; font-size:1rem; font-weight:600; }
        .form-head-sub { font-size:0.7rem; color:var(--muted); margin-top:1px; }
        .form-body { padding:20px 24px; }
        .form-body textarea { width:100%; padding:14px 16px; background:var(--input-bg); border:1.5px solid rgba(255,255,255,0.07); border-radius:10px; color:var(--white); font-family:'Outfit',sans-serif; font-size:0.9rem; outline:none; resize:vertical; min-height:120px; line-height:1.6; transition:border-color 0.2s; }
        .form-body textarea:focus { border-color:var(--gold); box-shadow:0 0 0 3px rgba(201,168,76,0.1); }
        .form-body textarea::placeholder { color:var(--muted); }
        .form-footer { padding:14px 24px; border-top:1px solid var(--border2); display:flex; justify-content:flex-end; }
        .btn-submit { display:inline-flex; align-items:center; gap:8px; padding:11px 28px; background:var(--gold); color:var(--bg); border:none; border-radius:9px; font-family:'Outfit',sans-serif; font-size:0.88rem; font-weight:600; cursor:pointer; transition:all 0.2s; }
        .btn-submit:hover { background:var(--gold2); }
        .closed-notice { padding:14px 22px; text-align:center; font-size:0.8rem; color:var(--muted); background:var(--panel); border:1px solid var(--border2); border-radius:12px; }

        @@media(max-width:768px) { .sidebar{display:none} .main{margin-left:0} .content{padding:20px} .topbar{padding:0 20px} }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div><div class="brand-name">NoteBank</div><div class="brand-sub">Student Portal</div></div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Browse</div>
            <a href="/Notes" class="nav-item"><span>🏠</span> Notes</a>
            <a href="/RelationQuestion" class="nav-item active"><span>❓</span> Questions</a>
            <div class="nav-label">My Account</div>
            <a href="/Notes/Upload" class="nav-item"><span>⬆️</span> Upload Note</a>
            <a href="/Notes/MyUploads" class="nav-item"><span>📋</span> My Uploads</a>
            <a href="/NoteRequest/MyRequests" class="nav-item"><span>📨</span> My Requests</a>
            <a href="/RelationQuestion/MyQuestions" class="nav-item"><span>🙋</span> My Questions</a>
            <div class="nav-label">Account</div>
            <a href="/Account/Profile" class="nav-item"><span>👤</span> Profile</a>
            <a href="/Account/Logout" class="nav-item"><span>🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">👤</div>
                <div>
                    <div class="user-name">@Context.Session.GetString("UserName")</div>
                    <div class="user-role">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div>
                <div class="breadcrumb">
                    <a href="/RelationQuestion">Questions</a><span>›</span>
                    <span class="current">Details</span>
                </div>
                <div class="topbar-title">Question Details</div>
            </div>
            <a href="/RelationQuestion" class="btn-back">← Back</a>
        </div>

        <div class="content">
            <!-- QUESTION -->
            <div class="question-card">
                <div class="question-head">
                    <div class="question-meta">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                "Answered" => "badge-answered",
                                "Closed" => "badge-closed",
                                _ => "badge-open"
                            };
                            var statusIcon = Model.Status switch
                            {
                                "Answered" => "✅",
                                "Closed" => "🔒",
                                _ => "🟢"
                            };
                        }
                        <span class="badge @badgeClass">@statusIcon @Model.Status</span>
                        @if (Model.Major != null) { <span class="tag">@Model.Major.Name</span> }
                        @if (Model.Term != null) { <span class="tag">@Model.Term.Name</span> }
                        @if (Model.Note != null) { <span class="tag">📄 @Model.Note.Title</span> }
                    </div>
                    <div class="question-title-text">@Model.Title</div>
                </div>
                <div class="question-body-text">@Model.Body</div>
                <div class="question-footer">
                    <div class="q-author">
                        Asked by <span>@Model.User?.FullName</span> · @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                    @if (isOwner && Model.Status != "Closed")
                    {
                        <form method="post" action="/RelationQuestion/CloseQuestion" style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn-close">🔒 Close Question</button>
                        </form>
                    }
                </div>
            </div>

            <!-- ANSWERS -->
            <div>
                <div class="section-title">
                    Answers <span class="count">@Model.Answers.Count</span>
                </div>

                @if (!Model.Answers.Any())
                {
                    <div class="no-answers">
                        <span class="no-answers-icon">💭</span>
                        <div class="no-answers-text">No answers yet. Be the first to answer!</div>
                    </div>
                }
                else
                {
                    <div class="answer-list">
                        @foreach (var answer in Model.Answers.OrderByDescending(a => a.IsAccepted).ThenBy(a => a.CreatedAt))
                        {
                            <div class="answer-card @(answer.IsAccepted ? "accepted" : "")">
                                <div class="answer-card-head">
                                    <div class="answer-author">
                                        <span>@answer.User?.FullName</span> · @answer.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                    </div>
                                    @if (answer.IsAccepted)
                                    {
                                        <span class="accepted-badge">✅ Accepted Answer</span>
                                    }
                                </div>
                                <div class="answer-body">@answer.Body</div>
                                @if (isOwner && !answer.IsAccepted && Model.Status != "Closed")
                                {
                                    <div class="answer-actions">
                                        <form method="post" action="/RelationQuestion/AcceptAnswer">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="answerId" value="@answer.Id" />
                                            <button type="submit" class="btn-accept">✔ Accept this Answer</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ANSWER FORM -->
            @if (Model.Status != "Closed")
            {
                if (currentUserId.HasValue)
                {
                    <div class="answer-form-card">
                        <div class="form-head">
                            <div class="form-head-icon">✍️</div>
                            <div>
                                <div class="form-head-title">Your Answer</div>
                                <div class="form-head-sub">আপনার উত্তর দিন – অন্যদের সাহায্য করুন</div>
                            </div>
                        </div>
                        <form method="post" action="/RelationQuestion/PostAnswer">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="questionId" value="@Model.Id" />
                            <div class="form-body">
                                <textarea name="body" placeholder="আপনার উত্তরটি এখানে লিখুন..." required></textarea>
                            </div>
                            <div class="form-footer">
                                <button type="submit" class="btn-submit">Post Answer →</button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="closed-notice">
                        <a href="/Account/Login" style="color:var(--gold)">Login</a> করুন উত্তর দিতে।
                    </div>
                }
            }
            else
            {
                <div class="closed-notice">🔒 This question is closed — no new answers accepted.</div>
            }
        </div>
    </div>
</body>
</html>
