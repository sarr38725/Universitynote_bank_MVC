@model IEnumerable<University_Notebank.Models.RelationQuestion>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Panel – Questions</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg:#080f1a; --panel:#0f1d30; --panel2:#122038;
            --gold:#c9a84c; --gold2:#e8c96a; --gold-dim:rgba(201,168,76,0.1);
            --border:rgba(201,168,76,0.18); --border2:rgba(255,255,255,0.05);
            --white:#ffffff; --muted:#6b7a99; --muted2:#8892a4;
            --sidebar:#0b1525;
        }
        body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--white); display:flex; min-height:100vh; }
        .sidebar { width:260px; background:var(--sidebar); border-right:1px solid var(--border2); display:flex; flex-direction:column; position:fixed; top:0; left:0; bottom:0; z-index:50; }
        .sidebar-brand { padding:28px 24px 24px; border-bottom:1px solid var(--border2); display:flex; align-items:center; gap:12px; }
        .brand-logo { width:40px; height:40px; background:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; }
        .brand-name { font-family:'Cormorant Garamond',serif; font-size:1.15rem; font-weight:700; }
        .brand-sub { font-size:0.7rem; color:var(--gold); letter-spacing:1.5px; text-transform:uppercase; }
        .sidebar-nav { flex:1; padding:24px 16px; display:flex; flex-direction:column; gap:4px; }
        .nav-label { font-size:0.65rem; color:var(--muted); letter-spacing:2px; text-transform:uppercase; padding:12px 8px 6px; font-weight:600; }
        .nav-item { display:flex; align-items:center; gap:12px; padding:11px 14px; border-radius:10px; text-decoration:none; color:var(--muted2); font-size:0.88rem; transition:all 0.2s; position:relative; }
        .nav-item:hover { background:rgba(255,255,255,0.04); color:var(--white); }
        .nav-item.active { background:var(--gold-dim); color:var(--gold); border:1px solid var(--border); }
        .nav-item.active::before { content:''; position:absolute; left:0; top:20%; bottom:20%; width:3px; background:var(--gold); border-radius:0 4px 4px 0; }
        .sidebar-footer { padding:16px; border-top:1px solid var(--border2); }
        .user-profile { display:flex; align-items:center; gap:10px; padding:12px; border-radius:10px; background:rgba(255,255,255,0.03); border:1px solid var(--border2); }
        .user-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--gold2)); display:flex; align-items:center; justify-content:center; font-size:16px; }
        .user-name { font-size:0.82rem; font-weight:600; }
        .user-role { font-size:0.7rem; color:var(--gold); }
        .main { margin-left:260px; flex:1; display:flex; flex-direction:column; }
        .topbar { height:68px; padding:0 36px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border2); background:rgba(8,15,26,0.8); backdrop-filter:blur(12px); position:sticky; top:0; z-index:40; }
        .topbar-title { font-family:'Cormorant Garamond',serif; font-size:1.5rem; font-weight:700; }
        .btn-primary { display:inline-flex; align-items:center; gap:8px; padding:10px 22px; background:var(--gold); color:var(--bg); border:none; border-radius:9px; font-family:'Outfit',sans-serif; font-size:0.88rem; font-weight:600; text-decoration:none; cursor:pointer; transition:all 0.2s; }
        .btn-primary:hover { background:var(--gold2); }
        .content { padding:36px; flex:1; }
        .alert { padding:14px 20px; border-radius:10px; margin-bottom:22px; font-size:0.88rem; }
        .alert-success { background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.3); color:#4ade80; }

        /* STATS */
        .stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:32px; }
        .stat-card { background:var(--panel); border:1px solid var(--border2); border-radius:14px; padding:20px 24px; }
        .stat-num { font-family:'Cormorant Garamond',serif; font-size:2rem; font-weight:700; color:var(--gold); }
        .stat-label { font-size:0.78rem; color:var(--muted); margin-top:4px; }

        /* TABLE */
        .section-title { font-family:'Cormorant Garamond',serif; font-size:1.1rem; font-weight:600; margin-bottom:16px; }
        .q-table { width:100%; border-collapse:collapse; }
        .q-table th { font-size:0.72rem; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:0.8px; padding:10px 16px; border-bottom:1px solid var(--border2); text-align:left; }
        .q-table td { padding:14px 16px; border-bottom:1px solid rgba(255,255,255,0.03); font-size:0.86rem; vertical-align:middle; }
        .q-table tr:last-child td { border-bottom:none; }
        .q-table tr:hover td { background:rgba(255,255,255,0.02); }
        .q-title-cell { font-weight:500; }
        .q-title-cell a { color:var(--white); text-decoration:none; }
        .q-title-cell a:hover { color:var(--gold); }
        .badge { display:inline-flex; align-items:center; gap:4px; padding:4px 12px; border-radius:100px; font-size:0.71rem; font-weight:600; }
        .badge-draft { background:rgba(107,114,153,0.15); color:var(--muted2); border:1px solid rgba(107,114,153,0.2); }
        .badge-published { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.2); }
        .badge-closed { background:rgba(239,68,68,0.08); color:#f87171; border:1px solid rgba(239,68,68,0.2); }
        .badge-active { background:rgba(59,130,246,0.1); color:#60a5fa; border:1px solid rgba(59,130,246,0.2); }
        .action-btns { display:flex; align-items:center; gap:8px; }
        .btn-sm { padding:6px 14px; border-radius:8px; font-family:'Outfit',sans-serif; font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.2s; border:none; text-decoration:none; display:inline-flex; align-items:center; gap:5px; }
        .btn-view { background:rgba(201,168,76,0.1); color:var(--gold); border:1px solid var(--border); }
        .btn-view:hover { background:rgba(201,168,76,0.2); }
        .btn-publish { background:rgba(34,197,94,0.1); color:#4ade80; border:1px solid rgba(34,197,94,0.25); }
        .btn-publish:hover { background:rgba(34,197,94,0.2); }
        .btn-close-q { background:rgba(239,68,68,0.08); color:#f87171; border:1px solid rgba(239,68,68,0.2); }
        .btn-close-q:hover { background:rgba(239,68,68,0.15); }
        .answers-pill { background:rgba(59,130,246,0.1); color:#60a5fa; border:1px solid rgba(59,130,246,0.2); padding:3px 10px; border-radius:100px; font-size:0.72rem; font-weight:600; }
        .empty-state { text-align:center; padding:60px 20px; }
        .empty-icon { font-size:2.8rem; opacity:0.3; display:block; margin-bottom:12px; }
        .empty-title { font-family:'Cormorant Garamond',serif; font-size:1.3rem; font-weight:600; margin-bottom:6px; }
        .empty-sub { font-size:0.82rem; color:var(--muted); margin-bottom:20px; }
        @@keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
        @@media(max-width:900px) { .stats-row{grid-template-columns:1fr 1fr} }
        @@media(max-width:768px) { .sidebar{display:none} .main{margin-left:0} .content{padding:20px} .topbar{padding:0 20px} .stats-row{grid-template-columns:1fr} }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div><div class="brand-name">NoteBank</div><div class="brand-sub">Teacher Panel</div></div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Questions</div>
            <a href="/RelationQuestion/TeacherPanel" class="nav-item active"><span>📋</span> My Questions</a>
            <a href="/RelationQuestion/Create" class="nav-item"><span>✏️</span> Ask New Question</a>
            <div class="nav-label">Notes</div>
            <a href="/Notes" class="nav-item"><span>🏠</span> Browse Notes</a>
            <a href="/Notes/Upload" class="nav-item"><span>⬆️</span> Upload Note</a>
            <div class="nav-label">Account</div>
            <a href="/Account/Profile" class="nav-item"><span>👤</span> Profile</a>
            <a href="/Account/Logout" class="nav-item"><span>🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">🎓</div>
                <div>
                    <div class="user-name">@Context.Session.GetString("UserName")</div>
                    <div class="user-role">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div class="topbar-title">My Questions</div>
            <a href="/RelationQuestion/Create" class="btn-primary">+ Ask New Question</a>
        </div>

        <div class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }

            @{
                int total = Model.Count();
                int published = Model.Count(q => q.IsPublished);
                int totalAnswers = Model.Sum(q => q.Answers.Count);
            }
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-num">@total</div>
                    <div class="stat-label">Total Questions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-num">@published</div>
                    <div class="stat-label">Published to Students</div>
                </div>
                <div class="stat-card">
                    <div class="stat-num">@totalAnswers</div>
                    <div class="stat-label">Total Student Answers</div>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <span class="empty-icon">✏️</span>
                    <div class="empty-title">No questions yet</div>
                    <div class="empty-sub">Students-দের জন্য প্রশ্ন তৈরি করুন।</div>
                    <a href="/RelationQuestion/Create" class="btn-primary">Ask Your First Question</a>
                </div>
            }
            else
            {
                <div class="section-title">All Questions</div>
                <table class="q-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Major / Term</th>
                            <th>Status</th>
                            <th>Answers</th>
                            <th>Deadline</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model)
                        {
                            string pubBadge = !q.IsPublished ? "badge-draft" : (q.Status == "Closed" ? "badge-closed" : (q.Status == "Active" ? "badge-active" : "badge-published"));
                            string pubLabel = !q.IsPublished ? "Draft" : (q.Status == "Closed" ? "Closed" : (q.Status == "Active" ? "Active" : "Published"));
                            <tr>
                                <td class="q-title-cell">
                                    <a href="/RelationQuestion/Details/@q.Id">@q.Title</a>
                                </td>
                                <td>
                                    @if (q.Major != null) { <span style="color:var(--muted2);font-size:0.82rem;">@q.Major.Name</span> }
                                    @if (q.Term != null) { <span style="color:var(--muted);font-size:0.78rem;"> / @q.Term.Name</span> }
                                </td>
                                <td><span class="badge @pubBadge">@pubLabel</span></td>
                                <td>
                                    @if (q.Answers.Any())
                                    {
                                        <span class="answers-pill">@q.Answers.Count answers</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--muted);font-size:0.78rem;">No answers</span>
                                    }
                                </td>
                                <td style="font-size:0.78rem;color:var(--muted);">
                                    @(q.Deadline.HasValue ? q.Deadline.Value.ToString("dd MMM yyyy") : "—")
                                </td>
                                <td>
                                    <div class="action-btns">
                                        @if (q.Answers.Any())
                                        {
                                            <a href="/RelationQuestion/ViewAnswers/@q.Id" class="btn-sm btn-view">📋 Answers</a>
                                        }
                                        @if (!q.IsPublished)
                                        {
                                            <form method="post" action="/RelationQuestion/Publish" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <button type="submit" class="btn-sm btn-publish">🚀 Publish</button>
                                            </form>
                                        }
                                        @if (q.IsPublished && q.Status != "Closed")
                                        {
                                            <form method="post" action="/RelationQuestion/CloseQuestion" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <button type="submit" class="btn-sm btn-close-q">🔒 Close</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</body>
</html>
