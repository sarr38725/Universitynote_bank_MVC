@model List<University_Notebank.Models.Note>
@{
    Layout = null;
    var totalNotes = Model.Count;
    var totalMajors = Model.Select(n => n.MajorId).Distinct().Count();
    var totalTerms = Model.Select(n => n.TermId).Distinct().Count();
    var recentNotes = Model.OrderByDescending(n => n.CreatedAt).Take(5).ToList();
    var pendingNotes = ViewBag.PendingNotes as List<University_Notebank.Models.Note> ?? new List<University_Notebank.Models.Note>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard – University NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #080f1a;
            --sidebar: #0b1525;
            --panel: #0f1d30;
            --panel2: #122038;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.12);
            --border: rgba(201,168,76,0.15);
            --border2: rgba(255,255,255,0.05);
            --white: #ffffff;
            --muted: #6b7a99;
            --muted2: #8892a4;
            --success: #22c55e;
            --info: #3b82f6;
            --purple: #a855f7;
            --red: #ef4444;
            --orange: #f97316;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg);
            color: var(--white);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: var(--sidebar);
            border-right: 1px solid var(--border2);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
        }

        .sidebar-brand {
            padding: 28px 24px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            background: var(--gold);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .brand-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--white);
        }

        .brand-sub {
            font-size: 0.7rem;
            color: var(--gold);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            flex: 1;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-label {
            font-size: 0.65rem;
            color: var(--muted);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 12px 8px 6px;
            font-weight: 600;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted2);
            font-size: 0.88rem;
            font-weight: 400;
            transition: all 0.2s;
            position: relative;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--white);
            }

            .nav-item.active {
                background: var(--gold-dim);
                color: var(--gold);
                border: 1px solid var(--border);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    background: var(--gold);
                    border-radius: 0 4px 4px 0;
                }

        .nav-icon {
            font-size: 1rem;
            width: 20px;
            text-align: center;
        }

        .nav-badge {
            margin-left: auto;
            background: var(--gold-dim);
            color: var(--gold);
            border: 1px solid var(--border);
            border-radius: 100px;
            font-size: 0.68rem;
            font-weight: 600;
            padding: 2px 8px;
        }

        .nav-badge-red {
            background: rgba(239,68,68,0.15);
            color: #f87171;
            border-color: rgba(239,68,68,0.3);
        }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--border2);
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border2);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), var(--gold2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .admin-info {
            flex: 1;
            min-width: 0;
        }

        .admin-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .admin-role {
            font-size: 0.7rem;
            color: var(--gold);
        }

        .logout-btn {
            color: var(--muted);
            text-decoration: none;
            font-size: 1rem;
            transition: color 0.2s;
        }

            .logout-btn:hover {
                color: var(--red);
            }

        /* MAIN */
        .main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 68px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border2);
            background: rgba(8,15,26,0.8);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .topbar-left h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--white);
        }

        .topbar-left p {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-add {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: var(--gold);
            color: var(--bg);
            border-radius: 10px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

            .btn-add:hover {
                background: var(--gold2);
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(201,168,76,0.3);
            }

        /* CONTENT */
        .content {
            padding: 32px 36px;
            flex: 1;
        }

        /* STAT CARDS */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 16px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s, transform 0.3s;
            animation: fadeUp 0.5s ease both;
        }

            .stat-card:nth-child(1) {
                animation-delay: 0s;
            }

            .stat-card:nth-child(2) {
                animation-delay: 0.08s;
            }

            .stat-card:nth-child(3) {
                animation-delay: 0.16s;
            }

            .stat-card:nth-child(4) {
                animation-delay: 0.24s;
            }

            .stat-card:hover {
                border-color: var(--border);
                transform: translateY(-2px);
            }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                opacity: 0;
                transition: opacity 0.3s;
            }

            .stat-card:hover::before {
                opacity: 1;
            }

        .stat-gold::before {
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .stat-blue::before {
            background: linear-gradient(90deg, transparent, var(--info), transparent);
        }

        .stat-green::before {
            background: linear-gradient(90deg, transparent, var(--success), transparent);
        }

        .stat-orange::before {
            background: linear-gradient(90deg, transparent, var(--orange), transparent);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .si-gold {
            background: rgba(201,168,76,0.12);
        }

        .si-blue {
            background: rgba(59,130,246,0.12);
        }

        .si-green {
            background: rgba(34,197,94,0.12);
        }

        .si-orange {
            background: rgba(249,115,22,0.12);
        }

        .stat-trend {
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 100px;
            font-weight: 500;
        }

        .trend-up {
            background: rgba(34,197,94,0.1);
            color: var(--success);
        }

        .trend-orange {
            background: rgba(249,115,22,0.1);
            color: var(--orange);
        }

        .stat-num {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.4rem;
            font-weight: 700;
            color: var(--white);
            line-height: 1;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 0.78rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* PENDING SECTION */
        .pending-section {
            margin-bottom: 28px;
            animation: fadeUp 0.5s ease 0.25s both;
        }

        .pending-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .pending-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--white);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pending-count {
            background: rgba(249,115,22,0.15);
            color: var(--orange);
            border: 1px solid rgba(249,115,22,0.3);
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 600;
            padding: 3px 10px;
        }

        .pending-card {
            background: var(--panel);
            border: 1px solid rgba(249,115,22,0.2);
            border-radius: 14px;
            padding: 18px 20px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            transition: border-color 0.2s;
        }

            .pending-card:hover {
                border-color: rgba(249,115,22,0.4);
            }

            .pending-card:last-child {
                margin-bottom: 0;
            }

        .pending-info {
            flex: 1;
            min-width: 0;
        }

        .pending-note-title {
            font-weight: 500;
            color: var(--white);
            font-size: 0.92rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 5px;
        }

        .pending-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .meta-tag {
            display: inline-block;
            padding: 2px 9px;
            border-radius: 100px;
            font-size: 0.68rem;
            font-weight: 500;
        }

        .meta-major {
            background: var(--gold-dim);
            color: var(--gold);
            border: 1px solid var(--border);
        }

        .meta-term {
            background: rgba(59,130,246,0.1);
            color: #60a5fa;
            border: 1px solid rgba(59,130,246,0.2);
        }

        .meta-batch {
            background: rgba(168,85,247,0.1);
            color: #c084fc;
            border: 1px solid rgba(168,85,247,0.2);
        }

        .meta-user {
            font-size: 0.72rem;
            color: var(--muted);
        }

        .meta-date {
            font-size: 0.72rem;
            color: var(--muted);
        }

        .pending-actions {
            display: flex;
            gap: 8px;
            flex-shrink: 0;
            align-items: center;
        }

        .btn-approve {
            padding: 7px 16px;
            background: rgba(34,197,94,0.1);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,0.25);
            border-radius: 8px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-approve:hover {
                background: rgba(34,197,94,0.2);
            }

        .btn-reject {
            padding: 7px 16px;
            background: rgba(239,68,68,0.1);
            color: #f87171;
            border: 1px solid rgba(239,68,68,0.25);
            border-radius: 8px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-reject:hover {
                background: rgba(239,68,68,0.2);
            }

        /* ✅ NEW: View button for pending notes */
        .btn-view {
            padding: 7px 14px;
            background: rgba(59,130,246,0.1);
            color: #60a5fa;
            border: 1px solid rgba(59,130,246,0.25);
            border-radius: 8px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .btn-view:hover {
                background: rgba(59,130,246,0.2);
            }

        .no-pending {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 14px;
            padding: 24px;
            text-align: center;
            color: var(--muted);
            font-size: 0.85rem;
        }

            .no-pending span {
                display: block;
                font-size: 2rem;
                margin-bottom: 8px;
                opacity: 0.4;
            }

        /* BOTTOM GRID */
        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 24px;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 16px;
            overflow: hidden;
            animation: fadeUp 0.5s ease 0.3s both;
        }

        .panel-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .panel-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--white);
        }

        .panel-sub {
            font-size: 0.75rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .btn-link {
            font-size: 0.8rem;
            color: var(--gold);
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.2s;
        }

            .btn-link:hover {
                opacity: 0.7;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            padding: 12px 24px;
            text-align: left;
            font-size: 0.72rem;
            color: var(--muted);
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border-bottom: 1px solid var(--border2);
            background: rgba(255,255,255,0.01);
        }

        tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.03);
            transition: background 0.15s;
        }

            tbody tr:last-child {
                border-bottom: none;
            }

            tbody tr:hover {
                background: rgba(255,255,255,0.02);
            }

        td {
            padding: 14px 24px;
            font-size: 0.85rem;
            vertical-align: middle;
        }

        .td-title {
            color: var(--white);
            font-weight: 500;
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .td-muted {
            color: var(--muted);
        }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 500;
        }

        .badge-gold {
            background: rgba(201,168,76,0.1);
            color: var(--gold);
            border: 1px solid var(--border);
        }

        .badge-blue {
            background: rgba(59,130,246,0.1);
            color: #60a5fa;
            border: 1px solid rgba(59,130,246,0.2);
        }

        .badge-purple {
            background: rgba(168,85,247,0.1);
            color: #c084fc;
            border: 1px solid rgba(168,85,247,0.2);
        }

        .td-actions {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            padding: 5px 12px;
            border-radius: 7px;
            font-size: 0.75rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .action-edit {
            color: var(--info);
            border-color: rgba(59,130,246,0.2);
            background: rgba(59,130,246,0.08);
        }

            .action-edit:hover {
                background: rgba(59,130,246,0.15);
            }

        .action-delete {
            color: var(--red);
            border-color: rgba(239,68,68,0.2);
            background: rgba(239,68,68,0.08);
        }

            .action-delete:hover {
                background: rgba(239,68,68,0.15);
            }

        /* RIGHT COL */
        .right-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .quick-actions {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 16px;
            padding: 20px;
            animation: fadeUp 0.5s ease 0.35s both;
        }

        .qa-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 16px;
        }

        .qa-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid var(--border2);
            background: rgba(255,255,255,0.02);
            color: var(--white);
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 400;
            text-decoration: none;
            margin-bottom: 8px;
            transition: all 0.2s;
            cursor: pointer;
        }

            .qa-btn:last-child {
                margin-bottom: 0;
            }

            .qa-btn:hover {
                border-color: var(--border);
                background: var(--gold-dim);
                color: var(--gold);
            }

        .qa-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .qi-gold {
            background: var(--gold-dim);
        }

        .qi-blue {
            background: rgba(59,130,246,0.1);
        }

        .qi-green {
            background: rgba(34,197,94,0.1);
        }

        .breakdown {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 16px;
            padding: 20px;
            animation: fadeUp 0.5s ease 0.4s both;
        }

        .breakdown-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

            .breakdown-item:last-child {
                border-bottom: none;
            }

        .bi-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .bi-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .bi-name {
            font-size: 0.85rem;
            color: var(--muted2);
        }

        .bi-count {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--white);
        }

        .section-divider {
            border: none;
            border-top: 1px solid var(--border2);
            margin: 16px 0 12px 0;
        }

        .section-label {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 600;
            color: var(--white);
            margin-bottom: 4px;
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.75);
            z-index: 200;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 20px;
            width: 90%;
            max-width: 600px;
            max-height: 85vh;
            overflow-y: auto;
            animation: fadeUp 0.3s ease;
        }

        .modal-header {
            padding: 24px 28px 20px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
        }

        .modal-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--white);
            line-height: 1.3;
        }

        .modal-close {
            background: rgba(255,255,255,0.06);
            border: 1px solid var(--border2);
            color: var(--muted);
            border-radius: 8px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .modal-close:hover {
                background: rgba(239,68,68,0.15);
                color: var(--red);
                border-color: rgba(239,68,68,0.3);
            }

        .modal-body {
            padding: 24px 28px;
        }

        .modal-cover {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 20px;
            display: block;
        }

        .modal-cover-placeholder {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, #0b1929, #112240);
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            opacity: 0.6;
        }

        .modal-field {
            margin-bottom: 16px;
        }

        .modal-field-label {
            font-size: 0.7rem;
            color: var(--muted);
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .modal-field-value {
            font-size: 0.9rem;
            color: var(--white);
            line-height: 1.6;
        }

        .modal-tags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .modal-footer {
            padding: 20px 28px;
            border-top: 1px solid var(--border2);
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .modal-btn-approve {
            padding: 10px 22px;
            background: rgba(34,197,94,0.15);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,0.3);
            border-radius: 9px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .modal-btn-approve:hover {
                background: rgba(34,197,94,0.25);
            }

        .modal-btn-reject {
            padding: 10px 22px;
            background: rgba(239,68,68,0.15);
            color: #f87171;
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 9px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .modal-btn-reject:hover {
                background: rgba(239,68,68,0.25);
            }

        .modal-btn-file {
            padding: 10px 22px;
            background: var(--gold-dim);
            color: var(--gold);
            border: 1px solid var(--border);
            border-radius: 9px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .modal-btn-file:hover {
                background: rgba(201,168,76,0.2);
            }

        .empty-state {
            text-align: center;
            padding: 48px 24px;
            color: var(--muted);
        }

            .empty-state .es-icon {
                font-size: 3rem;
                margin-bottom: 12px;
                display: block;
            }

            .empty-state p {
                font-size: 0.88rem;
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1200px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .bottom-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
            }

            .content {
                padding: 20px;
            }

            .topbar {
                padding: 0 20px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
        }
    </style>
</head>
<body>

    <!-- ══ SIDEBAR ══ -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div class="brand-text">
                <div class="brand-name">NoteBank</div>
                <div class="brand-sub">Admin Panel</div>
            </div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Main</div>
            <a href="/Admin" class="nav-item active"><span class="nav-icon">🏠</span> Dashboard</a>
            <a href="/Notes" class="nav-item"><span class="nav-icon">👁</span> Student View</a>
            <div class="nav-label">Content</div>
            <a href="/Admin/Create" class="nav-item"><span class="nav-icon">➕</span> Add New Note</a>
            <a href="/Admin" class="nav-item"><span class="nav-icon">📋</span> Manage Notes <span class="nav-badge">@totalNotes</span></a>
            @if (pendingNotes.Count > 0)
            {
                <a href="#pending-section" class="nav-item"><span class="nav-icon">⏳</span> Pending Approval <span class="nav-badge nav-badge-red">@pendingNotes.Count</span></a>
            }
            <div class="nav-label">Account</div>
            <a href="/Account/Logout" class="nav-item"><span class="nav-icon">🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="admin-profile">
                <div class="admin-avatar">👤</div>
                <div class="admin-info">
                    <div class="admin-name">@Context.Session.GetString("UserName")</div>
                    <div class="admin-role">Administrator</div>
                </div>
                <a href="/Account/Logout" class="logout-btn" title="Logout">↗</a>
            </div>
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <div class="main">
        <div class="topbar">
            <div class="topbar-left">
                <h1>Dashboard</h1>
                <p>Welcome back, @Context.Session.GetString("UserName") 👋</p>
            </div>
            <div class="topbar-right">
                <a href="/Admin/Create" class="btn-add">＋ Add Note</a>
            </div>
        </div>

        <div class="content">

            <!-- STAT CARDS -->
            <div class="stats-grid">
                <div class="stat-card stat-gold">
                    <div class="stat-top"><div class="stat-icon si-gold">📝</div><span class="stat-trend trend-up">↑ Active</span></div>
                    <div class="stat-num">@totalNotes</div>
                    <div class="stat-label">Total Notes</div>
                </div>
                <div class="stat-card stat-blue">
                    <div class="stat-top"><div class="stat-icon si-blue">🎓</div><span class="stat-trend trend-up">↑ Active</span></div>
                    <div class="stat-num">@totalMajors</div>
                    <div class="stat-label">Majors Covered</div>
                </div>
                <div class="stat-card stat-green">
                    <div class="stat-top"><div class="stat-icon si-green">📅</div><span class="stat-trend trend-up">↑ Active</span></div>
                    <div class="stat-num">@totalTerms</div>
                    <div class="stat-label">Terms Available</div>
                </div>
                <div class="stat-card stat-orange">
                    <div class="stat-top"><div class="stat-icon si-orange">⏳</div><span class="stat-trend trend-orange">Needs Review</span></div>
                    <div class="stat-num">@pendingNotes.Count</div>
                    <div class="stat-label">Pending Approval</div>
                </div>
            </div>

            <!-- ✅ PENDING NOTES SECTION -->
            <div class="pending-section" id="pending-section">
                <div class="pending-header">
                    <div class="pending-title">
                        ⏳ Pending Approval
                        @if (pendingNotes.Count > 0)
                        {
                            <span class="pending-count">@pendingNotes.Count waiting</span>
                        }
                    </div>
                </div>

                @if (!pendingNotes.Any())
                {
                    <div class="no-pending">
                        <span>✅</span>
                        All caught up! No notes waiting for approval.
                    </div>
                }
                else
                {
                    @foreach (var note in pendingNotes)
                    {
                        <div class="pending-card">
                            <div class="pending-info">
                                <div class="pending-note-title">@note.Title</div>
                                <div class="pending-meta">
                                    @if (note.Major != null)
                                    {
                                        <span class="meta-tag meta-major">@note.Major.Name</span>
                                    }
                                    @if (note.Term != null)
                                    {
                                        <span class="meta-tag meta-term">@note.Term.Name</span>
                                    }
                                    @if (note.Batch.HasValue)
                                    {
                                        <span class="meta-tag meta-batch">Batch @note.Batch</span>
                                    }
                                    <span class="meta-user">👤 @note.Uploader?.FullName</span>
                                    <span class="meta-date">📅 @note.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="pending-actions">

                                <button type="button" class="btn-view"
                                        onclick="openModal(
                                                '@note.Id',
                                                '@Html.Raw(note.Title?.Replace("'", "\\'"))',
                                                '@Html.Raw(note.Description?.Replace("'", "\\'") ?? "No description provided.")',
                                                '@(note.Major?.Name ?? "")',
                                                '@(note.Term?.Name ?? "")',
                                                '@(note.Batch.HasValue ? "Batch " + note.Batch : "")',
                                                '@(note.Uploader?.FullName ?? "")',
                                                '@note.CreatedAt.ToString("dd MMM yyyy")',
                                                '@(note.CoverImagePath ?? "")',
                                                '@(note.FilePath ?? "")',
                                                '@(note.FileName ?? "")',
                                                '@(note.FileType ?? "")'
                                            )">
                                    👁 View
                                </button>

                                <form method="post" action="/Admin/Approve/@note.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-approve">✓ Approve</button>
                                </form>
                                <form method="post" action="/Admin/Reject/@note.Id" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-reject">✕ Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- BOTTOM GRID -->
            <div class="bottom-grid">
                <div class="panel">
                    <div class="panel-header">
                        <div>
                            <div class="panel-title">All Approved Notes</div>
                            <div class="panel-sub">Manage your academic content</div>
                        </div>
                        <a href="/Admin/Create" class="btn-link">+ Add New</a>
                    </div>
                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <span class="es-icon">📭</span>
                            <p>No approved notes yet.</p>
                        </div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Major</th>
                                    <th>Term</th>
                                    <th>Batch</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in Model)
                                {
                                    <tr>
                                        <td class="td-title" title="@note.Title">@note.Title</td>
                                        <td><span class="badge badge-gold">@note.Major?.Name</span></td>
                                        <td><span class="badge badge-blue">@note.Term?.Name</span></td>
                                        <td>
                                            @if (note.Batch.HasValue)
                                            {
                                                <span class="badge badge-purple">Batch @note.Batch</span>
                                            }
                                            else
                                            {

                                                <span class="td-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="td-actions">
                                                <a href="/Admin/Edit/@note.Id" class="action-btn action-edit">Edit</a>
                                                <a href="/Admin/Delete/@note.Id" class="action-btn action-delete">Delete</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <div class="right-col">
                    <div class="quick-actions">
                        <div class="qa-title">Quick Actions</div>
                        <a href="/Admin/Create" class="qa-btn"><div class="qa-icon qi-gold">➕</div> Add New Note</a>
                        <a href="/Notes" class="qa-btn"><div class="qa-icon qi-blue">👁</div> Preview Student View</a>
                        <a href="/Account/Logout" class="qa-btn"><div class="qa-icon qi-green">🚪</div> Logout</a>
                    </div>

                    <div class="breakdown">
                        <div class="panel-header" style="padding:0 0 16px 0;border-bottom:1px solid var(--border2);margin-bottom:8px;">
                            <div><div class="panel-title">By Major</div><div class="panel-sub">Note distribution</div></div>
                        </div>
                        @{
                            var colors = new[] { "#c9a84c", "#3b82f6", "#22c55e", "#a855f7", "#ef4444", "#f97316" };
                            var byMajor = Model.GroupBy(n => n.Major?.Name ?? "Unknown")
                            .Select((g, i) => new { Name = g.Key, Count = g.Count(), Color = colors[i % colors.Length] })
                            .OrderByDescending(x => x.Count).ToList();
                        }
                        @if (!byMajor.Any())
                        {
                            <p style="color:var(--muted);font-size:0.82rem;padding:12px 0;">No data yet.</p>
                        }
                        else
                        {
                            @foreach (var item in byMajor)
                            {
                                <div class="breakdown-item">
                                    <div class="bi-left"><div class="bi-dot" style="background:@item.Color"></div><span class="bi-name">@item.Name</span></div>
                                    <span class="bi-count">@item.Count</span>
                                </div>
                            }
                        }
                        <hr class="section-divider" />
                        <div class="section-label">By Batch</div>
                        <div class="panel-sub" style="margin-bottom:8px;">Batch distribution</div>
                        @{
                            var byBatch = Model.Where(n => n.Batch.HasValue)
                            .GroupBy(n => n.Batch.Value)
                            .Select(g => new { Batch = g.Key, Count = g.Count() })
                            .OrderBy(x => x.Batch).ToList();
                        }
                        @if (!byBatch.Any())
                        {
                            <p style="color:var(--muted);font-size:0.82rem;padding:8px 0;">No batch data yet.</p>
                        }
                        else
                        {
                            @foreach (var item in byBatch)
                            {
                                <div class="breakdown-item">
                                    <div class="bi-left"><div class="bi-dot" style="background:#a855f7"></div><span class="bi-name">Batch @item.Batch</span></div>
                                    <span class="bi-count">@item.Count</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ VIEW DETAILS MODAL -->
    <div class="modal-overlay" id="noteModal">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="modalTitle"></div>
                <button class="modal-close" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body">
                <div id="modalCover"></div>
                <div class="modal-field">
                    <div class="modal-field-label">Description</div>
                    <div class="modal-field-value" id="modalDesc"></div>
                </div>
                <div class="modal-field">
                    <div class="modal-field-label">Details</div>
                    <div class="modal-tags" id="modalTags"></div>
                </div>
                <div class="modal-field">
                    <div class="modal-field-label">Uploaded By</div>
                    <div class="modal-field-value" id="modalUploader"></div>
                </div>
                <div class="modal-field">
                    <div class="modal-field-label">Submitted On</div>
                    <div class="modal-field-value" id="modalDate"></div>
                </div>
                <div class="modal-field" id="modalFileSection" style="display:none;">
                    <div class="modal-field-label">Attached File</div>
                    <div class="modal-field-value" id="modalFileName"></div>
                </div>
            </div>
            <div class="modal-footer">
                <a href="#" id="modalFileBtn" class="modal-btn-file" target="_blank" style="display:none;">📎 Download File</a>
                <form method="post" id="modalRejectForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="modal-btn-reject">✕ Reject</button>
                </form>
                <form method="post" id="modalApproveForm" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="modal-btn-approve">✓ Approve</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        function openModal(id, title, desc, major, term, batch, uploader, date, coverPath, filePath, fileName, fileType) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalDesc').textContent = desc || 'No description provided.';
            document.getElementById('modalUploader').textContent = '👤 ' + (uploader || 'Unknown');
            document.getElementById('modalDate').textContent = date;

            // Cover image
            const coverEl = document.getElementById('modalCover');
            if (coverPath) {
                coverEl.innerHTML = `<img src="${coverPath}" class="modal-cover" alt="Cover" />`;
            } else {
                const icon = fileType === '.pdf' ? '📕' : fileType === '.docx' || fileType === '.doc' ? '📘' : fileType === '.pptx' || fileType === '.ppt' ? '📙' : '📄';
                coverEl.innerHTML = `<div class="modal-cover-placeholder">${icon}</div>`;
            }

            // Tags
            let tags = '';
            if (major) tags += `<span class="meta-tag meta-major">${major}</span>`;
            if (term) tags += `<span class="meta-tag meta-term">${term}</span>`;
            if (batch) tags += `<span class="meta-tag meta-batch">${batch}</span>`;
            document.getElementById('modalTags').innerHTML = tags;

            // File
            if (filePath) {
                document.getElementById('modalFileSection').style.display = 'block';
                document.getElementById('modalFileName').textContent = fileName + ' (' + fileType + ')';
                const fileBtn = document.getElementById('modalFileBtn');
                fileBtn.href = filePath;
                fileBtn.style.display = 'inline-flex';
            } else {
                document.getElementById('modalFileSection').style.display = 'none';
                document.getElementById('modalFileBtn').style.display = 'none';
            }

            // Form actions
            document.getElementById('modalApproveForm').action = '/Admin/Approve/' + id;
            document.getElementById('modalRejectForm').action = '/Admin/Reject/' + id;

            document.getElementById('noteModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('noteModal').classList.remove('show');
        }

        // Close on overlay click
        document.getElementById('noteModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    </script>

</body>
</html>
