@model University_Notebank.Models.NoteRequest
@{
    Layout = null;
    int adminId = (int)Context.Session.GetInt32("UserId");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request Detail – Admin Panel</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #080f1a;
            --panel: #0f1d30;
            --panel2: #122038;
            --sidebar: #0b1525;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.1);
            --border: rgba(201,168,76,0.18);
            --border2: rgba(255,255,255,0.05);
            --white: #ffffff;
            --muted: #6b7a99;
            --muted2: #8892a4;
            --red: #ef4444;
            --green: #22c55e;
            --blue: #3b82f6;
            --input-bg: #0b1828;
        }

        body {
            font-family: 'Outfit',sans-serif;
            background: var(--bg);
            color: var(--white);
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar);
            border-right: 1px solid var(--border2);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
        }

        .sidebar-brand {
            padding: 28px 24px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            background: var(--gold);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .brand-name {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.15rem;
            font-weight: 700;
        }

        .brand-sub {
            font-size: 0.7rem;
            color: var(--gold);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            flex: 1;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-label {
            font-size: 0.65rem;
            color: var(--muted);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 12px 8px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted2);
            font-size: 0.88rem;
            transition: all 0.2s;
            position: relative;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--white);
            }

            .nav-item.active {
                background: var(--gold-dim);
                color: var(--gold);
                border: 1px solid var(--border);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    background: var(--gold);
                    border-radius: 0 4px 4px 0;
                }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--border2);
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border2);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--gold),var(--gold2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .admin-name {
            font-size: 0.82rem;
            font-weight: 600;
        }

        .admin-role {
            font-size: 0.7rem;
            color: var(--gold);
        }

        .main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 68px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border2);
            background: rgba(8,15,26,0.8);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            margin-bottom: 3px;
        }

            .breadcrumb a {
                color: var(--muted);
                text-decoration: none;
            }

                .breadcrumb a:hover {
                    color: var(--gold);
                }

            .breadcrumb .current {
                color: var(--white);
                font-weight: 500;
            }

        .topbar-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .btn-back {
            padding: 9px 20px;
            border: 1px solid var(--border2);
            border-radius: 9px;
            color: var(--muted2);
            font-size: 0.85rem;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-back:hover {
                border-color: var(--border);
                color: var(--white);
            }

        .content {
            padding: 36px;
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 24px;
            align-items: start;
        }

        /* LEFT */
        .left-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* INFO CARD */
        .info-card {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 18px;
            overflow: hidden;
        }

        .card-head {
            padding: 20px 26px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-head-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .head-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: var(--gold-dim);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .head-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.05rem;
            font-weight: 600;
        }

        .head-sub {
            font-size: 0.73rem;
            color: var(--muted);
            margin-top: 2px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 14px;
            border-radius: 100px;
            font-size: 0.73rem;
            font-weight: 600;
        }

        .badge-pending {
            background: rgba(234,179,8,0.12);
            color: #facc15;
            border: 1px solid rgba(234,179,8,0.25);
        }

        .badge-reviewed {
            background: rgba(59,130,246,0.12);
            color: #60a5fa;
            border: 1px solid rgba(59,130,246,0.25);
        }

        .badge-fulfilled {
            background: rgba(34,197,94,0.12);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,0.25);
        }

        .badge-rejected {
            background: rgba(239,68,68,0.12);
            color: #f87171;
            border: 1px solid rgba(239,68,68,0.25);
        }

        .card-body {
            padding: 22px 26px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .info-row {
            display: flex;
            gap: 12px;
        }

        .info-label {
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            min-width: 90px;
            padding-top: 2px;
        }

        .info-value {
            font-size: 0.88rem;
            color: var(--white);
            line-height: 1.5;
        }

        /* REQUESTER INFO */
        .user-card {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 18px;
            padding: 22px 26px;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-ava {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--gold),var(--gold2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .user-info-name {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .user-info-meta {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 3px;
        }

        /* ADMIN ACTIONS */
        .action-card {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 18px;
            overflow: hidden;
        }

        .action-head {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .action-head-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--gold-dim);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .action-head-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1rem;
            font-weight: 600;
        }

        .action-body {
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-fulfill {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 12px;
            background: rgba(34,197,94,0.12);
            border: 1px solid rgba(34,197,94,0.3);
            border-radius: 10px;
            color: #4ade80;
            font-family: 'Outfit',sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-fulfill:hover {
                background: rgba(34,197,94,0.2);
            }

        .btn-reject-full {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 12px;
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 10px;
            color: #f87171;
            font-family: 'Outfit',sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .btn-reject-full:hover {
                background: rgba(239,68,68,0.2);
            }

        .action-note {
            font-size: 0.73rem;
            color: var(--muted);
            text-align: center;
        }

        /* CHAT */
        .chat-panel {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 18px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .chat-head {
            padding: 18px 22px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chat-head-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            background: var(--gold-dim);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .chat-head-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1rem;
            font-weight: 600;
        }

        .chat-head-sub {
            font-size: 0.7rem;
            color: var(--muted);
            margin-top: 1px;
        }

        .chat-messages {
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 400px;
            overflow-y: auto;
        }

            .chat-messages::-webkit-scrollbar {
                width: 4px;
            }

            .chat-messages::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 4px;
            }

        .msg-wrap {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .msg-wrap.admin-msg {
                align-items: flex-end;
            }

            .msg-wrap.user-msg {
                align-items: flex-start;
            }

        .msg-bubble {
            max-width: 85%;
            padding: 11px 16px;
            border-radius: 14px;
            font-size: 0.85rem;
            line-height: 1.55;
        }

        .msg-wrap.admin-msg .msg-bubble {
            background: var(--gold-dim);
            border: 1px solid var(--border);
            border-bottom-right-radius: 4px;
        }

        .msg-wrap.user-msg .msg-bubble {
            background: rgba(59,130,246,0.1);
            border: 1px solid rgba(59,130,246,0.2);
            border-bottom-left-radius: 4px;
        }

        .msg-meta {
            font-size: 0.68rem;
            color: var(--muted);
        }

        .no-messages {
            text-align: center;
            padding: 30px;
        }

        .no-messages-icon {
            font-size: 2rem;
            opacity: 0.35;
            display: block;
            margin-bottom: 8px;
        }

        .no-messages-text {
            font-size: 0.8rem;
            color: var(--muted);
        }

        .chat-input {
            padding: 16px;
            border-top: 1px solid var(--border2);
        }

        .chat-form {
            display: flex;
            gap: 10px;
        }

            .chat-form textarea {
                flex: 1;
                padding: 11px 14px;
                background: var(--input-bg);
                border: 1.5px solid rgba(255,255,255,0.07);
                border-radius: 10px;
                color: var(--white);
                font-family: 'Outfit',sans-serif;
                font-size: 0.85rem;
                outline: none;
                resize: none;
                min-height: 44px;
                max-height: 100px;
                transition: border-color 0.2s;
            }

                .chat-form textarea:focus {
                    border-color: var(--gold);
                }

                .chat-form textarea::placeholder {
                    color: var(--muted);
                }

        .btn-send {
            padding: 0 18px;
            background: var(--gold);
            color: var(--bg);
            border: none;
            border-radius: 10px;
            font-family: 'Outfit',sans-serif;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .btn-send:hover {
                background: var(--gold2);
            }

        @@media(max-width:1000px) {
            .content {
                grid-template-columns: 1fr
            }
        }

        @@media(max-width:768px) {
            .sidebar {
                display: none
            }

            .main {
                margin-left: 0
            }

            .content {
                padding: 20px
            }

            .topbar {
                padding: 0 20px
            }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div><div class="brand-name">NoteBank</div><div class="brand-sub">Admin Panel</div></div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Main</div>
            <a href="/Admin" class="nav-item"><span>🏠</span> Dashboard</a>
            <a href="/Notes" class="nav-item"><span>👁</span> Student View</a>
            <div class="nav-label">Content</div>
            <a href="/Admin/Create" class="nav-item"><span>➕</span> Add New Note</a>
            <a href="/Admin" class="nav-item"><span>📋</span> Manage Notes</a>
            <a href="/Admin/Requests" class="nav-item active"><span>📨</span> Note Requests</a>
            <div class="nav-label">Account</div>
            <a href="/Account/Logout" class="nav-item"><span>🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="admin-profile">
                <div class="admin-avatar">👤</div>
                <div>
                    <div class="admin-name">@Context.Session.GetString("UserName")</div>
                    <div class="admin-role">Administrator</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div>
                <div class="breadcrumb">
                    <a href="/Admin">Dashboard</a><span>›</span>
                    <a href="/Admin/Requests">Requests</a><span>›</span>
                    <span class="current">Detail</span>
                </div>
                <div class="topbar-title">Request Detail</div>
            </div>
            <a href="/Admin/Requests" class="btn-back">← Back</a>
        </div>

        <div class="content">
            <!-- LEFT COLUMN -->
            <div class="left-col">

                <!-- Request Info -->
                <div class="info-card">
                    <div class="card-head">
                        <div class="card-head-left">
                            <div class="head-icon">📩</div>
                            <div>
                                <div class="head-title">@Model.Subject</div>
                                <div class="head-sub">Submitted @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                        </div>
                        @{
                            var badgeClass = Model.Status switch
                            {
                                    "Reviewed" => "badge-reviewed",
                                    "Fulfilled" => "badge-fulfilled",
                                    "Rejected" => "badge-rejected",
                                _ => "badge-pending"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="info-row">
                                <div class="info-label">Details</div>
                                <div class="info-value">@Model.Description</div>
                            </div>
                        }
                        @if (Model.Major != null)
                        {
                            <div class="info-row">
                                <div class="info-label">Major</div>
                                <div class="info-value">@Model.Major.Name</div>
                            </div>
                        }
                        @if (Model.Term != null)
                        {
                            <div class="info-row">
                                <div class="info-label">Term</div>
                                <div class="info-value">@Model.Term.Name</div>
                            </div>
                        }
                        @if (Model.Batch.HasValue)
                        {
                            <div class="info-row">
                                <div class="info-label">Batch</div>
                                <div class="info-value">Batch @Model.Batch</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Requester -->
                <div class="user-card">
                    <div class="user-ava">👤</div>
                    <div>
                        <div class="user-info-name">@Model.User?.FullName</div>
                        <div class="user-info-meta">@Model.User?.Email · @Model.User?.Role</div>
                        @if (!string.IsNullOrEmpty(Model.User?.Department))
                        {
                            <div class="user-info-meta">Dept: @Model.User.Department</div>
                        }
                    </div>
                </div>

                <!-- Chat (left side, full width on mobile) -->
                <div class="chat-panel">
                    <div class="chat-head">
                        <div class="chat-head-icon">💬</div>
                        <div>
                            <div class="chat-head-title">Conversation</div>
                            <div class="chat-head-sub">Reply to the student's request</div>
                        </div>
                    </div>

                    <div class="chat-messages" id="chatBox">
                        @if (!Model.Messages.Any())
                        {
                            <div class="no-messages">
                                <span class="no-messages-icon">💭</span>
                                <div class="no-messages-text">No messages yet. Send a reply below.</div>
                            </div>
                        }
                        @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
                        {
                            bool isAdmin = msg.IsAdmin;
                            <div class="msg-wrap @(isAdmin ? "admin-msg" : "user-msg")">
                                <div class="msg-bubble">@msg.Message</div>
                                <div class="msg-meta">
                                    @(isAdmin ? "Admin" : msg.Sender?.FullName) · @msg.SentAt.ToString("dd MMM, hh:mm tt")
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.Status != "Rejected" && Model.Status != "Fulfilled")
                    {
                        <div class="chat-input">
                            <form method="post" action="/Admin/SendReply" class="chat-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@Model.Id" />
                                <textarea name="message" placeholder="Type your reply… (Enter to send)" rows="1" required></textarea>
                                <button type="submit" class="btn-send">Send</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div style="padding:14px; text-align:center; font-size:0.78rem; color:var(--muted); border-top:1px solid var(--border2);">
                            Request is @Model.Status — messaging closed.
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: Admin Actions -->
            <div>
                @if (Model.Status != "Rejected" && Model.Status != "Fulfilled")
                {
                    <div class="action-card">
                        <div class="action-head">
                            <div class="action-head-icon">⚡</div>
                            <div class="action-head-title">Admin Actions</div>
                        </div>
                        <div class="action-body">
                            <!-- Mark Fulfilled -->
                            <form method="post" action="/Admin/FulfillRequest/@Model.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-fulfill">✅ Mark as Fulfilled</button>
                            </form>
                            <div class="action-note">Use after you have uploaded the requested note</div>

                            <!-- Upload Note for this request -->
                            <a href="/Admin/Create" class="btn-fulfill" style="text-decoration:none; margin-top:4px;">➕ Upload Note Now</a>
                            <div class="action-note">Opens the note creation form</div>

                            <div style="height:1px; background:var(--border2); margin:6px 0;"></div>

                            <!-- Reject -->
                            <form method="post" action="/Admin/RejectRequest/@Model.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-reject-full" onclick="return confirm('Reject this request?')">❌ Reject Request</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="action-card">
                        <div class="action-body" style="text-align:center; padding:30px; color:var(--muted); font-size:0.88rem;">
                            This request is <strong style="color:var(--white)">@Model.Status</strong>.<br />No further actions available.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        const chatBox = document.getElementById('chatBox');
        if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

        const ta = document.querySelector('.chat-form textarea');
        if (ta) {
            ta.addEventListener('input', () => {
                ta.style.height = 'auto';
                ta.style.height = Math.min(ta.scrollHeight, 100) + 'px';
            });
            ta.addEventListener('keydown', e => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    ta.closest('form').submit();
                }
            });
        }
    </script>
</body>
</html>