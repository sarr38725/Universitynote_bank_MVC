@model IEnumerable<University_Notebank.Models.NoteRequest>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Requests – NoteBank</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #080f1a;
            --panel: #0f1d30;
            --panel2: #122038;
            --sidebar: #0b1525;
            --gold: #c9a84c;
            --gold2: #e8c96a;
            --gold-dim: rgba(201,168,76,0.1);
            --border: rgba(201,168,76,0.18);
            --border2: rgba(255,255,255,0.05);
            --white: #ffffff;
            --muted: #6b7a99;
            --muted2: #8892a4;
            --green: #22c55e;
            --red: #ef4444;
            --blue: #3b82f6;
            --purple: #a855f7;
        }

        body {
            font-family: 'Outfit',sans-serif;
            background: var(--bg);
            color: var(--white);
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar);
            border-right: 1px solid var(--border2);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 50;
        }

        .sidebar-brand {
            padding: 28px 24px 24px;
            border-bottom: 1px solid var(--border2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            background: var(--gold);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .brand-name {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.15rem;
            font-weight: 700;
        }

        .brand-sub {
            font-size: 0.7rem;
            color: var(--gold);
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .sidebar-nav {
            flex: 1;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-label {
            font-size: 0.65rem;
            color: var(--muted);
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 12px 8px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: var(--muted2);
            font-size: 0.88rem;
            transition: all 0.2s;
            position: relative;
        }

            .nav-item:hover {
                background: rgba(255,255,255,0.04);
                color: var(--white);
            }

            .nav-item.active {
                background: var(--gold-dim);
                color: var(--gold);
                border: 1px solid var(--border);
            }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    background: var(--gold);
                    border-radius: 0 4px 4px 0;
                }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--border2);
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 10px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border2);
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--gold),var(--gold2));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .admin-name {
            font-size: 0.82rem;
            font-weight: 600;
        }

        .admin-role {
            font-size: 0.7rem;
            color: var(--gold);
        }

        .main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 68px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border2);
            background: rgba(8,15,26,0.8);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.82rem;
            margin-bottom: 3px;
        }

            .breadcrumb a {
                color: var(--muted);
                text-decoration: none;
            }

                .breadcrumb a:hover {
                    color: var(--gold);
                }

            .breadcrumb .current {
                color: var(--white);
                font-weight: 500;
            }

        .topbar-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .btn-new {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: var(--gold);
            color: var(--bg);
            border: none;
            border-radius: 9px;
            font-family: 'Outfit',sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }

            .btn-new:hover {
                background: var(--gold2);
                transform: translateY(-1px);
            }

        .content {
            padding: 36px;
            flex: 1;
        }

        .alert-success {
            background: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.3);
            color: #4ade80;
            padding: 14px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 0.88rem;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

        .empty-icon {
            font-size: 4rem;
            display: block;
            margin-bottom: 16px;
            opacity: 0.4;
        }

        .empty-title {
            font-family: 'Cormorant Garamond',serif;
            font-size: 1.5rem;
            color: var(--muted2);
            margin-bottom: 8px;
        }

        .empty-sub {
            font-size: 0.85rem;
            color: var(--muted);
            margin-bottom: 24px;
        }

        .request-grid {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .request-card {
            background: var(--panel);
            border: 1px solid var(--border2);
            border-radius: 14px;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.2s;
            animation: fadeUp 0.4s ease;
        }

            .request-card:hover {
                border-color: var(--border);
                background: var(--panel2);
            }

        .req-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: rgba(255,255,255,0.04);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .req-body {
            flex: 1;
            min-width: 0;
        }

        .req-subject {
            font-weight: 600;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .req-meta {
            font-size: 0.76rem;
            color: var(--muted);
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .req-msg-count {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .req-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .badge-pending {
            background: rgba(234,179,8,0.12);
            color: #facc15;
            border: 1px solid rgba(234,179,8,0.25);
        }

        .badge-reviewed {
            background: rgba(59,130,246,0.12);
            color: #60a5fa;
            border: 1px solid rgba(59,130,246,0.25);
        }

        .badge-fulfilled {
            background: rgba(34,197,94,0.12);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,0.25);
        }

        .badge-rejected {
            background: rgba(239,68,68,0.12);
            color: #f87171;
            border: 1px solid rgba(239,68,68,0.25);
        }

        .btn-view {
            padding: 7px 18px;
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--gold);
            font-size: 0.8rem;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s;
        }

            .btn-view:hover {
                background: var(--gold-dim);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@media(max-width:768px) {
            .sidebar {
                display: none
            }

            .main {
                margin-left: 0
            }

            .content {
                padding: 20px
            }

            .topbar {
                padding: 0 20px
            }

            .request-card {
                flex-wrap: wrap
            }
        }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">📚</div>
            <div><div class="brand-name">NoteBank</div><div class="brand-sub">Student Portal</div></div>
        </div>
        <nav class="sidebar-nav">
            <div class="nav-label">Browse</div>
            <a href="/Notes" class="nav-item"><span>🏠</span> Notes</a>
            <div class="nav-label">My Account</div>
            <a href="/Notes/Upload" class="nav-item"><span>⬆️</span> Upload Note</a>
            <a href="/Notes/MyUploads" class="nav-item"><span>📋</span> My Uploads</a>
            <a href="/NoteRequest/MyRequests" class="nav-item active"><span>📨</span> My Requests</a>
            <a href="/NoteRequest/Create" class="nav-item"><span>✉️</span> New Request</a>
            <div class="nav-label">Account</div>
            <a href="/Account/Profile" class="nav-item"><span>👤</span> Profile</a>
            <a href="/Account/Logout" class="nav-item"><span>🚪</span> Logout</a>
        </nav>
        <div class="sidebar-footer">
            <div class="admin-profile">
                <div class="admin-avatar">👤</div>
                <div>
                    <div class="admin-name">@Context.Session.GetString("UserName")</div>
                    <div class="admin-role">@Context.Session.GetString("UserRole")</div>
                </div>
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div>
                <div class="breadcrumb">
                    <a href="/Notes">Home</a><span>›</span><span class="current">My Requests</span>
                </div>
                <div class="topbar-title">My Note Requests</div>
            </div>
            <a href="/NoteRequest/Create" class="btn-new">✉️ New Request</a>
        </div>

        <div class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success">✅ @TempData["Success"]</div>
            }

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <div class="empty-title">No requests yet</div>
                    <div class="empty-sub">Admin-এর কাছে note request পাঠান — তারা upload করবেন বা reply দেবেন।</div>
                    <a href="/NoteRequest/Create" class="btn-new">✉️ Send First Request</a>
                </div>
            }
            else
            {
                <div class="request-grid">
                    @foreach (var r in Model)
                    {
                        var badgeClass = r.Status switch
                        {
                                    "Reviewed" => "badge-reviewed",
                                    "Fulfilled" => "badge-fulfilled",
                                    "Rejected" => "badge-rejected",
                            _ => "badge-pending"
                        };
                        var statusIcon = r.Status switch
                        {
                                    "Reviewed" => "💬",
                                    "Fulfilled" => "✅",
                                    "Rejected" => "❌",
                            _ => "⏳"
                        };
                        <div class="request-card">
                            <div class="req-icon">📩</div>
                            <div class="req-body">
                                <div class="req-subject">@r.Subject</div>
                                <div class="req-meta">
                                    <span>@r.CreatedAt.ToString("dd MMM yyyy")</span>
                                    @if (r.Major != null)
                                    {
                                        <span>· @r.Major.Name</span>
                                    }
                                    @if (r.Term != null)
                                    {
                                        <span>· @r.Term.Name</span>
                                    }
                                    @if (r.Batch.HasValue)
                                    {
                                        <span>· Batch @r.Batch</span>
                                    }
                                    <span class="req-msg-count">· 💬 @r.Messages.Count</span>
                                </div>
                            </div>
                            <div class="req-actions">
                                <span class="badge @badgeClass">@statusIcon @r.Status</span>
                                <a href="/NoteRequest/Details/@r.Id" class="btn-view">View →</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</body>
</html>